---
import QRCode from 'qrcode';

const websiteUrl = 'https://www.eng.kagawa-u.ac.jp/~osaki/';
const qrSvg = await QRCode.toString(websiteUrl, {
  type: 'svg',
  errorCorrectionLevel: 'H',
  margin: 3,
  color: { dark: '#111111', light: '#ffffff' }
});
---

<dl class="contact-list contact-website-list" aria-label="研究室公式Webサイト">
  <div class="contact-website-entry">
    <dt>Website</dt>
    <dd>
      <a href={websiteUrl} class="contact-website-link" target="_blank" rel="noopener noreferrer">
        www.eng.kagawa-u.ac.jp/~osaki/
      </a>
    </dd>
    <button type="button" class="contact-website-qr" data-qr-open aria-label="研究室WebサイトのQRコードを拡大表示する" aria-haspopup="dialog">
      <span class="contact-qr-graphic" set:html={qrSvg} aria-hidden="true"></span>
      <span class="contact-qr-expand" aria-hidden="true">↗</span>
    </button>
  </div>
</dl>

<dialog class="contact-qr-dialog" data-qr-dialog aria-label="研究室WebサイトのQRコード">
  <div class="contact-qr-dialog-header">
    <div>
      <span class="contact-website-kicker">Science Communication Design Laboratory</span>
      <h3>Website QR code</h3>
    </div>
    <button type="button" class="contact-qr-close" data-qr-close aria-label="閉じる">×</button>
  </div>
  <div class="contact-qr-large" set:html={qrSvg} aria-hidden="true"></div>
  <a href={websiteUrl} target="_blank" rel="noopener noreferrer" class="contact-qr-dialog-link">{websiteUrl}</a>
</dialog>

<style>
  /* Inherit the very same label, link and row metrics as Tel and Email.
     No independent QR caption or special website typography. */
  .contact-website-list {
    margin:0 !important;
    padding:0;
    border-top:0;
  }
  .contact-website-list > .contact-website-entry {
    display:grid;
    grid-template-columns:56px minmax(0,1fr) 72px;
    gap:14px;
    align-items:center;
    padding:9px 0;
    margin:0;
    border-bottom:1px solid var(--line);
    font-size:inherit;
    line-height:inherit;
  }
  .contact-website-entry dt {
    color:var(--muted);
    text-transform:uppercase;
    letter-spacing:.08em;
    font-family:inherit;
    font-size:inherit;
    font-weight:inherit;
    line-height:inherit;
  }
  .contact-website-entry dd {
    margin:0;
    min-width:0;
    font:inherit;
    line-height:inherit;
    overflow-wrap:anywhere;
  }
  .contact-website-link {
    color:#111;
    display:inline;
    font:inherit;
    font-size:inherit;
    font-weight:inherit;
    letter-spacing:inherit;
    line-height:inherit;
    text-decoration:none;
    border-bottom:1px solid rgba(17,17,17,.25);
    padding-bottom:2px;
    overflow-wrap:anywhere;
  }
  .contact-website-link:hover { border-color:#111; }
  .contact-website-qr {
    position:relative;
    flex:none;
    width:72px;
    height:72px;
    padding:5px;
    border:1px solid rgba(0,0,0,.16);
    border-radius:0;
    background:#fff;
    display:block;
    cursor:zoom-in;
    transition:border-color .18s ease;
  }
  .contact-website-qr:hover { border-color:#111; }
  .contact-website-qr:focus-visible,
  .contact-qr-close:focus-visible,
  .contact-qr-dialog-link:focus-visible {
    outline:2px solid #111;
    outline-offset:3px;
  }
  .contact-qr-graphic { display:block; width:100%; height:100%; }
  .contact-qr-graphic :global(svg) { display:block; width:100%; height:100%; }
  .contact-qr-expand {
    position:absolute;
    right:2px;
    bottom:2px;
    background:white;
    color:#111;
    font-size:10px;
    line-height:1;
    padding:2px;
  }
  .contact-qr-dialog {
    z-index:9999;
    width:min(88vw,460px);
    max-height:min(92dvh,710px);
    padding:clamp(20px,4vw,34px);
    border:1px solid #999;
    border-radius:0;
    background:#fff;
    color:#111;
    box-shadow:none;
    overflow:auto;
  }
  .contact-qr-dialog::backdrop { background:rgba(0,0,0,.66); backdrop-filter:blur(3px); }
  .contact-qr-dialog-header { display:flex; align-items:start; justify-content:space-between; gap:16px; }
  .contact-qr-dialog-header h3 { font-size:23px; font-weight:350; line-height:1.2; margin:0; }
  .contact-website-kicker {
    display:block;
    font-size:10px;
    font-weight:500;
    line-height:1.4;
    letter-spacing:.13em;
    text-transform:uppercase;
    color:#666;
    margin-bottom:12px;
  }
  .contact-qr-close {
    border:0;
    padding:0 6px;
    background:transparent;
    font-size:31px;
    line-height:1;
    font-weight:300;
    color:#111;
    cursor:pointer;
  }
  .contact-qr-large {
    width:min(100%,360px);
    aspect-ratio:1;
    background:white;
    margin:22px auto;
  }
  .contact-qr-large :global(svg) { display:block; width:100%; height:100%; }
  .contact-qr-dialog-link {
    display:block;
    font-size:12px;
    color:#111;
    text-decoration:underline;
    text-underline-offset:3px;
    overflow-wrap:anywhere;
    text-align:center;
  }
  @media(max-width:580px) {
    .contact-website-list > .contact-website-entry {
      grid-template-columns:56px minmax(0,1fr) 60px;
      gap:10px;
    }
    .contact-website-qr { width:60px; height:60px; padding:4px; }
  }
</style>

<script>
  // Native dialog: keyboard accessible, Escape closes, focus returns to the trigger.
  const openButton = document.querySelector('[data-qr-open]');
  const dialog = document.querySelector('[data-qr-dialog]');
  const closeButton = dialog?.querySelector('[data-qr-close]');
  if (openButton && dialog instanceof HTMLDialogElement) {
    openButton.addEventListener('click', () => dialog.showModal());
    closeButton?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => openButton.focus({ preventScroll:true }));
  }
</script>
