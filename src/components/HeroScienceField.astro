<div class="science-field" aria-hidden="true">
  <canvas class="optics-canvas" data-optics width="1200" height="640"></canvas>

  <figure class="science-object object-water">
    <svg viewBox="0 0 220 150" role="img">
      <g fill="none" stroke="currentColor" stroke-width="1.7" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round">
