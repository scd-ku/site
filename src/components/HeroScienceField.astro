          <text x="22" y="58" fill="currentColor" stroke="none" font-size="8">N</text>
          <text x="68" y="78" fill="currentColor" stroke="none" font-size="8">N</text>
          <text x="43" y="113" fill="currentColor" stroke="none" font-size="8">NH₂</text>
        </g>

        <!-- Guanine: 2-amino-6-oxopurine -->
        <g transform="translate(444 17)">
          <text x="0" y="0" fill="currentColor" stroke="none" font-size="10.5">Guanine · C₅H₅N₅O</text>
          <polygon points="43,29 67,43 67,71 43,85 19,71 19,43"/>
