          <circle cx="105" cy="20" r="0.6"/><circle cx="132" cy="25" r="0.6"/><circle cx="156" cy="38" r="0.6"/>
          <circle cx="175" cy="57" r="0.6"/><circle cx="186" cy="84" r="0.6"/><circle cx="189" cy="112" r="0.6"/>
          <circle cx="181" cy="139" r="0.6"/><circle cx="166" cy="163" r="0.6"/><circle cx="143" cy="181" r="0.6"/>
          <circle cx="116" cy="189" r="0.6"/><circle cx="88" cy="187" r="0.6"/><circle cx="62" cy="178" r="0.6"/>
          <circle cx="40" cy="160" r="0.6"/><circle cx="26" cy="136" r="0.6"/><circle cx="21" cy="108" r="0.6"/>
          <circle cx="26" cy="80" r="0.6"/><circle cx="39" cy="55" r="0.6"/><circle cx="60" cy="36" r="0.6"/>
        </g>
      </g>
    </svg>
  </figure>

  <figure class="science-object object-solid object-cube-3d"><canvas data-solid="cube" width="180" height="180"></canvas></figure>
  <figure class="science-object object-solid object-octa-3d"><canvas data-solid="octahedron" width="170" height="170"></canvas></figure>
  <figure class="science-object object-solid object-tetra-3d"><canvas data-solid="tetrahedron" width="170" height="170"></canvas></figure>

  <figure class="science-object object-nh4cl">
    <svg viewBox="0 0 220 220" role="img">
      <g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" vector-effect="non-scaling-stroke" stroke-linejoin="round">
        <path d="M110 18 123 56 162 44 136 76 176 94 133 103 152 142 119 118 110 168 101 118 68 142 87 103 44 94 84 76 58 44 97 56Z"/>
        <path d="M110 35 116 60 143 56 126 78 151 91 126 96 137 122 116 109 110 138 104 109 83 122 94 96 69 91 94 78 77 56 104 60Z" opacity=".62"/>
        <path d="M110 18v150M58 44l105 98M162 44 58 142M44 94h132" opacity=".44"/>
      </g>
    </svg>
  </figure>

  <!-- More rigorous skeletal formulas: double bonds, heteroatoms, exocyclic groups -->
