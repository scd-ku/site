          <line x1="47" y1="84" x2="47" y2="93"/>
        </g>

        <!-- Thymine: 5-methylpyrimidine-2,4-dione -->
        <g transform="translate(152 17)">
          <text x="0" y="0" fill="currentColor" stroke="none" font-size="10.5">Thymine · C₅H₆N₂O₂</text>
          <polygon points="50,29 75,43 75,71 50,85 25,71 25,43"/>
          <line x1="34" y1="42" x2="61" y2="42"/><line x1="34" y1="46" x2="61" y2="46"/>
          <line x1="75" y1="48" x2="87" y2="35"/><line x1="78" y1="51" x2="90" y2="38"/>
          <line x1="50" y1="85" x2="50" y2="102"/><line x1="54" y1="85" x2="54" y2="102"/>
          <text x="92" y="38" fill="currentColor" stroke="none" font-size="8">O</text>
          <text x="47" y="113" fill="currentColor" stroke="none" font-size="8">O</text>
          <text x="22" y="58" fill="currentColor" stroke="none" font-size="8">N</text>
          <text x="69" y="78" fill="currentColor" stroke="none" font-size="8">N</text>
          <line x1="25" y1="43" x2="11" y2="35"/>
          <text x="0" y="36" fill="currentColor" stroke="none" font-size="8">CH₃</text>
        </g>

        <!-- Cytosine: 4-aminopyrimidin-2-one -->
        <g transform="translate(300 17)">
          <text x="0" y="0" fill="currentColor" stroke="none" font-size="10.5">Cytosine · C₄H₅N₃O</text>
          <polygon points="50,29 75,43 75,71 50,85 25,71 25,43"/>
          <line x1="34" y1="42" x2="61" y2="42"/><line x1="34" y1="46" x2="61" y2="46"/>
