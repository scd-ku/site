        <circle cx="55" cy="46" r="18" />
        <circle cx="166" cy="46" r="18" />
        <line x1="89" y1="67" x2="67" y2="54" />
        <line x1="132" y1="67" x2="154" y2="54" />
        <path d="M106 55a37 37 0 0 1 10 0" opacity=".6"/>
      </g>
    </svg>
  </figure>

  <figure class="science-object object-chloroplast">
    <svg viewBox="0 0 340 200" role="img">
      <defs>
        <pattern id="chl-hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
          <line x1="0" y1="0" x2="0" y2="8" stroke="rgba(255,255,255,.88)" stroke-width="1.25"/>
        </pattern>
        <pattern id="stroma-dots" width="13" height="13" patternUnits="userSpaceOnUse">
          <circle cx="3" cy="4" r=".55" fill="rgba(255,255,255,.38)"/>
          <circle cx="10" cy="9" r=".45" fill="rgba(255,255,255,.25)"/>
        </pattern>
      </defs>
      <g fill="none" stroke="currentColor" stroke-width="1.25" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round">
        <ellipse cx="170" cy="100" rx="141" ry="74"/>
        <ellipse cx="170" cy="100" rx="129" ry="64" opacity=".58"/>
        <ellipse cx="170" cy="100" rx="122" ry="58" fill="url(#stroma-dots)" stroke="none" opacity=".55"/>

        <g fill="url(#chl-hatch)" stroke="currentColor">
          <rect x="78" y="67" width="43" height="14" rx="7"/>
          <rect x="84" y="72" width="43" height="14" rx="7"/>
          <rect x="90" y="77" width="43" height="14" rx="7"/>
          <rect x="96" y="82" width="43" height="14" rx="7"/>

          <rect x="186" y="61" width="48" height="15" rx="7.5"/>
          <rect x="192" y="66" width="48" height="15" rx="7.5"/>
          <rect x="198" y="71" width="48" height="15" rx="7.5"/>

          <rect x="125" y="117" width="50" height="15" rx="7.5"/>
          <rect x="131" y="122" width="50" height="15" rx="7.5"/>
          <rect x="137" y="127" width="50" height="15" rx="7.5"/>

          <rect x="224" y="111" width="38" height="14" rx="7"/>
          <rect x="229" y="116" width="38" height="14" rx="7"/>
        </g>

        <!-- stroma lamellae connecting grana -->
        <path d="M132 80 C151 88 169 91 192 78" opacity=".74"/>
        <path d="M137 89 C156 99 174 104 199 85" opacity=".58"/>
        <path d="M175 124 C193 119 207 116 225 119" opacity=".7"/>
        <path d="M121 92 C124 105 127 112 137 121" opacity=".56"/>
        <path d="M201 87 C207 97 215 105 230 111" opacity=".48"/>

        <!-- stromal DNA / starch grain hints -->
        <path d="M72 123c10-12 25-12 35 0s25 12 35 0" opacity=".35"/>
        <ellipse cx="267" cy="82" rx="20" ry="12" opacity=".3"/>
      </g>
    </svg>
  </figure>

  <figure class="science-object object-volvox">
    <svg viewBox="0 0 210 210" role="img">
      <defs>
        <pattern id="volvox-hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
          <line x1="0" y1="0" x2="0" y2="8" stroke="rgba(255,255,255,.88)" stroke-width="1.2"/>
        </pattern>
      </defs>
      <g fill="none" stroke="currentColor" stroke-width="1.2" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="105" cy="105" r="84" />
        <circle cx="143" cy="130" r="22" fill="url(#volvox-hatch)" opacity=".42"/>
        <circle cx="68" cy="136" r="14" fill="url(#volvox-hatch)" opacity=".34"/>
        <circle cx="101" cy="73" r="18" fill="url(#volvox-hatch)" opacity=".18"/>
