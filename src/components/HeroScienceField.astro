    <svg viewBox="0 0 600 205" role="img">
      <g fill="none" stroke="currentColor" stroke-width="1.05" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round">
        <!-- Adenine: 6-aminopurine -->
        <g transform="translate(5 17)">
          <text x="0" y="0" fill="currentColor" stroke="none" font-size="10.5">Adenine · C₅H₅N₅</text>
          <polygon points="46,29 70,43 70,71 46,85 22,71 22,43"/>
          <polygon points="70,43 92,35 106,52 100,74 77,79 70,71"/>
          <line x1="28" y1="47" x2="42" y2="35"/><line x1="31" y1="51" x2="45" y2="39"/>
          <line x1="51" y1="35" x2="65" y2="42"/><line x1="52" y1="39" x2="64" y2="45"/>
          <line x1="79" y1="45" x2="96" y2="39"/><line x1="81" y1="49" x2="98" y2="43"/>
          <line x1="81" y1="73" x2="96" y2="68"/><line x1="84" y1="77" x2="99" y2="72"/>
          <text x="19" y="57" fill="currentColor" stroke="none" font-size="8">N</text>
          <text x="59" y="40" fill="currentColor" stroke="none" font-size="8">N</text>
