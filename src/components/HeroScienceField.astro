          <text x="40" y="113" fill="currentColor" stroke="none" font-size="8">O</text>
          <text x="16" y="57" fill="currentColor" stroke="none" font-size="8">N</text>
          <text x="56" y="40" fill="currentColor" stroke="none" font-size="8">N</text>
          <text x="75" y="54" fill="currentColor" stroke="none" font-size="8">N</text>
          <text x="83" y="75" fill="currentColor" stroke="none" font-size="8">N</text>
