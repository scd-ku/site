---
const { apps } = Astro.props;
const sortedApps = [...apps].sort((a, b) => {
  const bt = b.updatedAt ? new Date(b.updatedAt).getTime() : 0;
  const at = a.updatedAt ? new Date(a.updatedAt).getTime() : 0;
  return bt - at;
});
const applicationProjects = sortedApps.filter((app) => app.kind !== 'tinkercad');
const modelProjects = sortedApps.filter((app) => app.kind === 'tinkercad');
const tags = [...new Set(sortedApps.flatMap((app) => app.tags))].sort((a, b) => a.localeCompare(b, 'en'));
const years = [...new Set(sortedApps.map((app) => app.year).filter(Boolean))].sort((a, b) => b - a);
const base = import.meta.env.BASE_URL;
const asset = (p) => `${base}${p.replace(/^\//, '')}`;
const goethePalette = [
  '#b64f56', // red
  '#c37043', // orange
  '#a88424', // yellow / ochre
  '#5f7d63', // green
  '#50738e', // blue
  '#725f7f', // violet
];
const colorForApp = (slug, index) => {
  const seed = [...slug].reduce((sum, ch) => sum + ch.charCodeAt(0), 0) + index * 17;
  return goethePalette[seed % goethePalette.length];
};
---
<section id="projects" class="projects-section">
  <div class="section-heading">
    <div>
      <h2>Projects</h2>
    </div>
    <div class="display-settings">
      <button class="display-settings-button" type="button" aria-expanded="false" aria-controls="display-settings-popover" title="Color display settings">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="6" cy="7" r="2.2"/><path d="M8.2 7H21"/>
          <circle cx="16" cy="12" r="2.2"/><path d="M3 12h10.8M18.2 12H21"/>
          <circle cx="9" cy="17" r="2.2"/><path d="M3 17h3.8M11.2 17H21"/>
        </svg>
      </button>
      <div class="display-settings-popover" id="display-settings-popover" hidden>
        <div class="display-settings-title">Display</div>
        <div class="settings-group">
          <div class="settings-group-label">Color</div>
          <div class="palette-modes" role="group" aria-label="Color mode">
            <button type="button" data-palette-mode="color" class="is-active">Color</button>
            <button type="button" data-palette-mode="mono">Mono</button>
            <button type="button" data-palette-mode="blind">Blind</button>
            <button type="button" data-palette-mode="redblue">Red / Blue</button>
          </div>
        </div>

        <div class="settings-group">
          <div class="settings-group-label">Columns</div>
          <div class="layout-modes layout-modes--columns" role="group" aria-label="Project columns">
            <button type="button" data-grid-columns="3">3</button>
            <button type="button" data-grid-columns="4" class="is-active">4</button>
            <button type="button" data-grid-columns="5">5</button>
          </div>
        </div>

        <div class="settings-group">
          <div class="settings-group-label">Tiles</div>
          <div class="layout-modes layout-modes--tiles" role="group" aria-label="Tile composition">
            <button type="button" data-tile-layout="ratio">4 : 3</button>
            <button type="button" data-tile-layout="square">Square</button>
            <button type="button" data-tile-layout="mondrian" class="is-active">Composite</button>
          </div>
        </div>

        <label class="saturation-control">
          <span data-screen-label>Color intensity</span>
          <input type="range" min="0" max="100" value="50" step="1" data-detail-saturation />
          <output data-detail-saturation-value>50%</output>
        </label>

        <div class="settings-group settings-group--cursor">
          <div class="settings-group-label">Cursor</div>
          <div class="layout-modes layout-modes--cursor" role="group" aria-label="Cursor mode">
            <button type="button" data-cursor-style="stripe" class="is-active">Stripe</button>
            <button type="button" data-cursor-style="invert">Invert</button>
            <button type="button" data-cursor-style="pulse">Circle</button>
            <button type="button" data-cursor-style="line">Line</button>
          </div>
          <label class="cursor-control">
            <span data-cursor-slider1-label>Motion</span>
            <input type="range" min="0" max="100" value="54" step="1" data-cursor-slider1 />
            <output data-cursor-slider1-value>54%</output>
          </label>
          <label class="cursor-control">
            <span data-cursor-slider2-label>Size</span>
            <input type="range" min="20" max="110" value="48" step="1" data-cursor-slider2 />
            <output data-cursor-slider2-value>48</output>
          </label>
        </div>
      </div>
    </div>
  </div>

  <div class="filters filters--primary" aria-label="Project type and development year filters">
    <button class="filter is-active" data-filter-type="all" type="button" aria-pressed="true">All</button>
    <button class="filter" data-filter-kind="web_app" type="button" aria-pressed="false">Web App</button>
    <button class="filter" data-filter-kind="tinkercad" type="button" aria-pressed="false">3D Printing</button>
    <span class="filter-label" aria-hidden="true">Development Year</span>
    {years.map((year) => <button class="filter" data-filter-year={String(year)} type="button" aria-pressed="false">{year}</button>)}
  </div>
  <div class="filters filters--topics" aria-label="Project topic filters">
    {tags.map((tag) => <button class="filter" data-filter-tag={tag} type="button" aria-pressed="false">{tag}</button>)}
  </div>

  <div class="project-group" data-project-group="applications">
    <div class="content-band" aria-label="Public applications">
      <span>Public applications</span><span class="content-band-count">{applicationProjects.length}</span>
    </div>
    <div class="app-grid" id="app-grid-applications">
    {applicationProjects.map((app, index) => (
      <article
        class={`app-card app-card--${app.size}`}
        data-tags={JSON.stringify(app.tags)}
        data-slug={app.slug}
        data-kind={app.kind || 'web_app'}
        data-year={String(app.year || '')}
        style={`--index:${index};--detail-bg:${colorForApp(app.slug, index)}`}
      >
        <a class="app-open" href={app.url} target="_blank" rel="noreferrer" aria-label={`${app.title} を開く`} data-project-open={app.slug} data-project-title={app.title} data-project-url={app.url} data-project-repo={app.repo || ''} data-project-kind={app.kind || 'web_app'}>
          <div class="card-visual" aria-hidden="true">
            <div class="fallback-art">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{app.title}</strong>
            </div>
            <img
              src={asset(`screenshots/${app.slug}.jpg`)}
              alt=""
              loading="lazy"
              onerror="this.style.display='none'"
            />
          </div>
          <div class="card-shade"></div>
          <div class="card-label">
            <div>
              <span class="card-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="card-title">{app.title}</span>
            </div>
          </div>
        </a>

        <div class="card-detail">
          <div class="detail-topline">
            <span>{app.repo || app.platform || "Project"}</span>
            <a
              class="detail-app-link"
              href={app.url}
              target="_blank"
              rel="noreferrer"
              aria-label={`${app.title} を開く`}
              data-project-open={app.slug}
              data-project-title={app.title}
              data-project-url={app.url}
              data-project-repo={app.repo || ''}
              data-project-kind={app.kind || 'web_app'}
            >{app.kind === "tinkercad" ? "Open model ↗" : "Open app ↗"}</a>
          </div>
          <p>{app.description}</p>
          <div class="card-meta">
            <span>{app.tags.join(' · ')}</span>
            <span class="card-meta-right">
              {(app.year || app.updatedAt) && (
                <span class="project-year">
                  {app.year ?? new Date(app.updatedAt).getFullYear()}
                  {((app.year ?? new Date(app.updatedAt).getFullYear()) === 2025 || app.originNote === 'ochanomizu') && <span class="project-year-note" aria-label="開発時期の注記">※</span>}
                </span>
              )}
              {app.repoUrl && (
                <a
                  class="repo-link"
                  href={app.repoUrl}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`${app.title} のGitHubリポジトリを開く`}
                  title="GitHub repository"
                  data-project-repo-open={app.slug}
                  data-project-title={app.title}
                  data-project-repo={app.repo || ''}
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.25a9.75 9.75 0 0 0-3.08 19c.49.09.67-.21.67-.47v-1.7c-2.73.59-3.31-1.16-3.31-1.16-.45-1.14-1.09-1.44-1.09-1.44-.89-.61.07-.6.07-.6.98.07 1.5 1.01 1.5 1.01.88 1.5 2.3 1.07 2.86.82.09-.64.34-1.07.62-1.32-2.18-.25-4.47-1.09-4.47-4.82 0-1.07.38-1.94 1-2.62-.1-.25-.43-1.25.1-2.59 0 0 .82-.26 2.68 1a9.3 9.3 0 0 1 4.88 0c1.86-1.26 2.68-1 2.68-1 .53 1.34.2 2.34.1 2.59.62.68 1 1.55 1 2.62 0 3.74-2.3 4.57-4.48 4.82.35.3.66.9.66 1.82v2.7c0 .26.18.56.68.47A9.75 9.75 0 0 0 12 2.25Z"/>
                  </svg>
                </a>
              )}
            </span>
          </div>
        </div>
        <button class="like-button" type="button" data-like={app.slug} data-project-title={app.title} data-project-url={app.url} data-project-repo={app.repo || ''} data-project-kind={app.kind || 'web_app'} aria-pressed="false" aria-label={`${app.title} にいいね`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"/></svg>
        </button>
      </article>
    ))}
    </div>
  </div>

  {modelProjects.length > 0 && (
    <div class="project-group project-group--models" data-project-group="models">
      <div class="content-band" aria-label="Public 3D models">
        <span>Public 3D models</span><span class="content-band-count">{modelProjects.length}</span>
      </div>
      <div class="app-grid" id="app-grid-models">
    {modelProjects.map((app, index) => (
      <article
        class={`app-card app-card--${app.size}`}
        data-tags={JSON.stringify(app.tags)}
        data-slug={app.slug}
        data-kind={app.kind || 'web_app'}
        data-year={String(app.year || '')}
        style={`--index:${applicationProjects.length + index};--detail-bg:${colorForApp(app.slug, applicationProjects.length + index)}`}
      >
        <a class="app-open" href={app.url} target="_blank" rel="noreferrer" aria-label={`${app.title} を開く`} data-project-open={app.slug} data-project-title={app.title} data-project-url={app.url} data-project-repo={app.repo || ''} data-project-kind={app.kind || 'web_app'}>
          <div class="card-visual" aria-hidden="true">
            <div class="fallback-art">
              <span>{String(applicationProjects.length + index + 1).padStart(2, '0')}</span>
              <strong>{app.title}</strong>
            </div>
            <img
              src={asset(`screenshots/${app.slug}.jpg`)}
              alt=""
              loading="lazy"
              onerror="this.style.display='none'"
            />
          </div>
          <div class="card-shade"></div>
          <div class="card-label">
            <div>
              <span class="card-number">{String(applicationProjects.length + index + 1).padStart(2, '0')}</span>
              <span class="card-title">{app.title}</span>
            </div>
          </div>
        </a>

        <div class="card-detail">
          <div class="detail-topline">
            <span>{app.repo || app.platform || "Project"}</span>
            <a
              class="detail-app-link"
              href={app.url}
              target="_blank"
              rel="noreferrer"
              aria-label={`${app.title} を開く`}
              data-project-open={app.slug}
              data-project-title={app.title}
              data-project-url={app.url}
              data-project-repo={app.repo || ''}
              data-project-kind={app.kind || 'web_app'}
            >{app.kind === "tinkercad" ? "Open model ↗" : "Open app ↗"}</a>
          </div>
          <p>{app.description}</p>
          <div class="card-meta">
            <span>{app.tags.join(' · ')}</span>
            <span class="card-meta-right">
              {(app.year || app.updatedAt) && (
                <span class="project-year">
                  {app.year ?? new Date(app.updatedAt).getFullYear()}
                  {((app.year ?? new Date(app.updatedAt).getFullYear()) === 2025 || app.originNote === 'ochanomizu') && <span class="project-year-note" aria-label="開発時期の注記">※</span>}
                </span>
              )}
              {app.repoUrl && (
                <a
                  class="repo-link"
                  href={app.repoUrl}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`${app.title} のGitHubリポジトリを開く`}
                  title="GitHub repository"
                  data-project-repo-open={app.slug}
                  data-project-title={app.title}
                  data-project-repo={app.repo || ''}
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.25a9.75 9.75 0 0 0-3.08 19c.49.09.67-.21.67-.47v-1.7c-2.73.59-3.31-1.16-3.31-1.16-.45-1.14-1.09-1.44-1.09-1.44-.89-.61.07-.6.07-.6.98.07 1.5 1.01 1.5 1.01.88 1.5 2.3 1.07 2.86.82.09-.64.34-1.07.62-1.32-2.18-.25-4.47-1.09-4.47-4.82 0-1.07.38-1.94 1-2.62-.1-.25-.43-1.25.1-2.59 0 0 .82-.26 2.68 1a9.3 9.3 0 0 1 4.88 0c1.86-1.26 2.68-1 2.68-1 .53 1.34.2 2.34.1 2.59.62.68 1 1.55 1 2.62 0 3.74-2.3 4.57-4.48 4.82.35.3.66.9.66 1.82v2.7c0 .26.18.56.68.47A9.75 9.75 0 0 0 12 2.25Z"/>
                  </svg>
                </a>
              )}
            </span>
          </div>
        </div>
        <button class="like-button" type="button" data-like={app.slug} data-project-title={app.title} data-project-url={app.url} data-project-repo={app.repo || ''} data-project-kind={app.kind || 'web_app'} aria-pressed="false" aria-label={`${app.title} にいいね`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"/></svg>
        </button>
      </article>
    ))}
      </div>
    </div>
  )}

  <script is:inline>
    (() => {
    const filters = [...document.querySelectorAll('.filter')];
    const allFilter = document.querySelector('[data-filter-type="all"]');
    const cards = [...document.querySelectorAll('.app-card')];
    const projectGroups = [...document.querySelectorAll('[data-project-group]')];

    const getSelected = (attribute) =>
      filters
        .filter((button) => button.classList.contains('is-active') && button.hasAttribute(attribute))
        .map((button) => button.getAttribute(attribute))
        .filter(Boolean);

    const refreshProjectGroups = () => {
      projectGroups.forEach((group) => {
        const visibleCards = [...group.querySelectorAll('.app-card')].filter((card) => !card.hidden);
        group.toggleAttribute('hidden', visibleCards.length === 0);
        const count = group.querySelector('.content-band-count');
        if (count) count.textContent = String(visibleCards.length);
      });
    };

    const applyProjectFilters = () => {
      const kinds = getSelected('data-filter-kind');
      const years = getSelected('data-filter-year');
      const tags = getSelected('data-filter-tag');
      const hasSelection = kinds.length > 0 || years.length > 0 || tags.length > 0;

      allFilter?.classList.toggle('is-active', !hasSelection);
      allFilter?.setAttribute('aria-pressed', String(!hasSelection));

      filters.forEach((button) => {
        if (button === allFilter) return;
        button.setAttribute('aria-pressed', String(button.classList.contains('is-active')));
      });

      cards.forEach((card) => {
        const cardTags = JSON.parse(card.dataset.tags || '[]');

        // OR inside the same filter group; AND between different groups.
        const kindMatch = kinds.length === 0 || kinds.includes(card.dataset.kind || '');
        const yearMatch = years.length === 0 || years.includes(card.dataset.year || '');
        const tagMatch = tags.length === 0 || tags.some((tag) => cardTags.includes(tag));
        const visible = kindMatch && yearMatch && tagMatch;

        card.classList.toggle('is-filtered-out', !visible);
        window.setTimeout(() => card.toggleAttribute('hidden', !visible), visible ? 0 : 180);
      });

      window.setTimeout(refreshProjectGroups, 190);
    };

    filters.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.classList.contains('is-active')));

      button.addEventListener('click', () => {
        if (button === allFilter) {
          filters.forEach((filter) => {
            filter.classList.toggle('is-active', filter === allFilter);
            filter.setAttribute('aria-pressed', String(filter === allFilter));
          });
        } else {
          button.classList.toggle('is-active');
          allFilter?.classList.remove('is-active');
        }
        applyProjectFilters();
      });
    });

    cards.forEach((card) => {
      card.addEventListener('pointerenter', () => document.body.dataset.cursor = 'open');
      card.addEventListener('pointerleave', () => delete document.body.dataset.cursor);
    });

    const trackProjectOpen = (link) => {
      window.scdTrack?.('project_open', {
        project_slug: link.dataset.projectOpen || '',
        project_title: link.dataset.projectTitle || '',
        project_url: link.dataset.projectUrl || link.href || '',
        project_repo: link.dataset.projectRepo || '',
        content_type: link.dataset.projectKind || 'web_app'
      });
    };
    document.querySelectorAll('[data-project-open]').forEach((link) => {
      link.addEventListener('click', () => trackProjectOpen(link));
      link.addEventListener('auxclick', (event) => {
        if (event.button === 1) trackProjectOpen(link);
      });
    });

    document.querySelectorAll('[data-project-repo-open]').forEach((link) => {
      const trackRepoOpen = () => window.scdTrack?.('project_repo_open', {
        project_slug: link.dataset.projectRepoOpen || '',
        project_title: link.dataset.projectTitle || '',
        project_repo: link.dataset.projectRepo || '',
        repository_url: link.href || '',
        content_type: 'source_repository'
      });
      link.addEventListener('click', trackRepoOpen);
      link.addEventListener('auxclick', (event) => {
        if (event.button === 1) trackRepoOpen();
      });
    });

    const settingsButton = document.querySelector('.display-settings-button');
    const settingsPopover = document.querySelector('.display-settings-popover');
    const paletteButtons = [...document.querySelectorAll('[data-palette-mode]')];
    const columnButtons = [...document.querySelectorAll('[data-grid-columns]')];
    const tileLayoutButtons = [...document.querySelectorAll('[data-tile-layout]')];
    const screenSlider = document.querySelector('[data-detail-saturation]');
    const screenValue = document.querySelector('[data-detail-saturation-value]');
    const screenLabel = document.querySelector('[data-screen-label]');
    const cursorButtons = [...document.querySelectorAll('[data-cursor-style]')];
    const cursorSlider1 = document.querySelector('[data-cursor-slider1]');
    const cursorSlider2 = document.querySelector('[data-cursor-slider2]');
    const cursorSlider1Label = document.querySelector('[data-cursor-slider1-label]');
    const cursorSlider2Label = document.querySelector('[data-cursor-slider2-label]');
    const cursorSlider1Value = document.querySelector('[data-cursor-slider1-value]');
    const cursorSlider2Value = document.querySelector('[data-cursor-slider2-value]');
    const clamp = (n,min,max) => Math.max(min,Math.min(max,n));

    // Every page load starts from the requested defaults. Changes last only for this page view.
    let colorIntensity = 50;
    let blindTone = 0;
    let monoDepth = 58;
    let currentMode = 'color';
    let currentColumns = '4';
    let currentTileLayout = 'mondrian';
    let uiCursorState = { style:'stripe', motion:54, size:48, zoom:1.5, lineHue:210, invertHue:0, trail:42 };

    const getCursorState = () => ({ ...uiCursorState });
    const sliderToZoom = (raw) => {
      const v = Math.max(0, Math.min(100, Number(raw)));
      return v <= 50 ? 0.1 + (v / 50) * 1.9 : 2 + ((v - 50) / 50) * 8;
    };
    const zoomToSlider = (zoom) => {
      const z = Math.max(0.1, Math.min(10, Number(zoom) || 1.5));
      return z <= 2 ? ((z - 0.1) / 1.9) * 50 : 50 + ((z - 2) / 8) * 50;
    };
    const formatZoom = (zoom) => {
      const z = Math.max(0.1, Math.min(10, Number(zoom) || 1.5));
      return z < 1 ? z.toFixed(1) : (Math.abs(z - Math.round(z)) < .05 ? String(Math.round(z)) : z.toFixed(1));
    };

    const updateCursorControls = (state) => {
      const style = state.style;
      cursorButtons.forEach((button) => button.classList.toggle('is-active', button.dataset.cursorStyle === style));
      if (!cursorSlider1 || !cursorSlider2) return;
      if (style === 'line') {
        cursorSlider1Label.textContent = 'Trail length';
        cursorSlider1.min='0'; cursorSlider1.max='100'; cursorSlider1.value=String(state.trail);
        cursorSlider1Value.textContent=`${state.trail}%`;
        cursorSlider2Label.textContent='Hue';
        cursorSlider2.min='0'; cursorSlider2.max='360'; cursorSlider2.value=String(state.lineHue);
        cursorSlider2Value.textContent=`${state.lineHue}°`;
      } else if (style === 'invert') {
        cursorSlider1Label.textContent = 'Circle size';
        cursorSlider1.min='20'; cursorSlider1.max='330'; cursorSlider1.value=String(state.size);
        cursorSlider1Value.textContent=String(state.size);
        cursorSlider2Label.textContent='Invert hue';
        cursorSlider2.min='0'; cursorSlider2.max='360'; cursorSlider2.value=String(state.invertHue);
        cursorSlider2Value.textContent=`${state.invertHue}°`;
      } else if (style === 'pulse' && currentMode !== 'blind') {
        cursorSlider1Label.textContent = 'Magnification';
        cursorSlider1.min='0'; cursorSlider1.max='100'; cursorSlider1.step='1'; cursorSlider1.value=String(zoomToSlider(state.zoom));
        cursorSlider1Value.textContent=`${formatZoom(state.zoom)}×`;
        cursorSlider2Label.textContent = 'Circle size';
        cursorSlider2.min='20'; cursorSlider2.max='330'; cursorSlider2.step='1'; cursorSlider2.value=String(state.size);
        cursorSlider2Value.textContent=String(state.size);
      } else {
        cursorSlider1Label.textContent = currentMode === 'blind' && style === 'pulse' ? 'Window pulse' : 'Motion';
        cursorSlider1.min='0'; cursorSlider1.max='100'; cursorSlider1.step='1'; cursorSlider1.value=String(state.motion);
        cursorSlider1Value.textContent=`${state.motion}%`;
        cursorSlider2Label.textContent = currentMode === 'blind' && style === 'pulse' ? 'Window diameter' : 'Size';
        cursorSlider2.min='20'; cursorSlider2.max='330'; cursorSlider2.step='1'; cursorSlider2.value=String(state.size);
        cursorSlider2Value.textContent=String(state.size);
      }
    };

    const emitCursorState = (state) => {
      uiCursorState = { ...uiCursorState, ...state };
      document.dispatchEvent(new CustomEvent('scd:update-cursor', { detail: uiCursorState }));
      updateCursorControls(uiCursorState);
    };

    const updateScreenControl = () => {
      if (!screenSlider) return;
      const blind = currentMode === 'blind';
      const color = currentMode === 'color';
      const mono = currentMode === 'mono';
      const value = blind ? blindTone : (mono ? monoDepth : colorIntensity);
      screenLabel.textContent = blind ? 'Screen tone' : (mono ? 'Black density' : (color ? 'Color intensity' : 'Color balance'));
      screenSlider.value = String(value);
      screenValue.textContent = `${value}%`;
    };

    const applyDisplaySettings = () => {
      document.documentElement.dataset.sitePalette = currentMode;
      document.documentElement.dataset.projectColumns = currentColumns;
      document.documentElement.dataset.projectLayout = currentTileLayout;
      const level = colorIntensity;
      const sat = level <= 50 ? 0.18 + (level / 50) * 0.92 : 1.10 + ((level - 50) / 50) * 1.55;
      const bright = level <= 50 ? 0.96 + (level / 50) * 0.16 : 1.12 + ((level - 50) / 50) * 0.10;
      const contrast = level <= 50 ? 0.98 : 1.0 + ((level - 50) / 50) * 0.08;
      document.documentElement.style.setProperty('--detail-saturation', String(sat));
      document.documentElement.style.setProperty('--detail-brightness', String(bright));
      document.documentElement.style.setProperty('--detail-contrast', String(contrast));
      document.documentElement.style.setProperty('--color-level', String(level));
      const monoLevel = monoDepth / 100;
      const monoBrightness = 1.13 - monoLevel * .50;
      const monoContrast = .88 + monoLevel * .72;
      const monoGray = Math.round(226 - monoLevel * 205);
      const monoText = monoGray < 118 ? '#fff' : '#080808';
      document.documentElement.style.setProperty('--mono-brightness', String(monoBrightness));
      document.documentElement.style.setProperty('--mono-contrast', String(monoContrast));
      document.documentElement.style.setProperty('--mono-gray', String(monoGray));
      document.documentElement.style.setProperty('--mono-text', monoText);
      paletteButtons.forEach((button) => button.classList.toggle('is-active', button.dataset.paletteMode === currentMode));
      columnButtons.forEach((button) => button.classList.toggle('is-active', button.dataset.gridColumns === currentColumns));
      tileLayoutButtons.forEach((button) => button.classList.toggle('is-active', button.dataset.tileLayout === currentTileLayout));
      updateScreenControl();
      if (currentMode === 'blind') {
        document.dispatchEvent(new CustomEvent('scd:update-blind-tone', { detail: { value: blindTone } }));
        const state = getCursorState();
        if (state.style !== 'pulse') state.style='pulse';
        if (state.size < 120) state.size=180;
        emitCursorState(state);
      } else {
        updateCursorControls(getCursorState());
      }
    };

    applyDisplaySettings();
    updateCursorControls(getCursorState());

    settingsButton?.addEventListener('click', () => {
      const willOpen = settingsPopover?.hasAttribute('hidden');
      settingsPopover?.toggleAttribute('hidden', !willOpen);
      settingsButton.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
    });

    paletteButtons.forEach((button) => button.addEventListener('click', () => {
      currentMode = button.dataset.paletteMode || 'color';
      if (currentMode === 'blind') blindTone = 0;
      applyDisplaySettings();
    }));
    columnButtons.forEach((button) => button.addEventListener('click', () => {
      currentColumns = button.dataset.gridColumns || '4';
      applyDisplaySettings();
    }));
    tileLayoutButtons.forEach((button) => button.addEventListener('click', () => {
      currentTileLayout = button.dataset.tileLayout || 'ratio';
      applyDisplaySettings();
    }));
    screenSlider?.addEventListener('input', () => {
      const value = Number(screenSlider.value);
      if (currentMode === 'blind') {
        blindTone = value;
        document.dispatchEvent(new CustomEvent('scd:update-blind-tone', { detail: { value } }));
      } else if (currentMode === 'mono') {
        monoDepth = value;
      } else {
        colorIntensity = value;
      }
      applyDisplaySettings();
    });

    cursorButtons.forEach((button) => button.addEventListener('click', () => {
      const state=getCursorState();
      state.style=button.dataset.cursorStyle || 'stripe';
      emitCursorState(state);
    }));
    cursorSlider1?.addEventListener('input', () => {
      const state=getCursorState();
      const value=Number(cursorSlider1.value);
      if (state.style === 'line') state.trail=value;
      else if (state.style === 'invert') state.size=value;
      else if (state.style === 'pulse' && currentMode !== 'blind') state.zoom=sliderToZoom(value);
      else state.motion=value;
      emitCursorState(state);
    });
    cursorSlider2?.addEventListener('input', () => {
      const state=getCursorState();
      const value=Number(cursorSlider2.value);
      if (state.style === 'line') state.lineHue=value;
      else if (state.style === 'invert') state.invertHue=value;
      else state.size=value;
      emitCursorState(state);
    });

    document.addEventListener('scd:cursor-state-applied', (event) => updateCursorControls(event.detail));
    document.addEventListener('pointerdown', (event) => {
      if (!settingsPopover || settingsPopover.hasAttribute('hidden')) return;
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('.display-settings-button')) return;
      if (target.closest('.display-settings-popover button, .display-settings-popover input')) return;
      settingsPopover.setAttribute('hidden', '');
      settingsButton?.setAttribute('aria-expanded', 'false');
    });

    document.querySelectorAll('[data-like]').forEach((button) => {
      const slug = button.dataset.like;
      const key = `scd_like_${slug}`;
      const paint = () => {
        const liked = localStorage.getItem(key) === '1';
        button.setAttribute('aria-pressed', liked ? 'true' : 'false');
        button.classList.toggle('is-liked', liked);
      };
      paint();
      button.addEventListener('click', (event) => {
        event.preventDefault(); event.stopPropagation();
        const liked = localStorage.getItem(key) === '1';
        localStorage.setItem(key, liked ? '0' : '1');
        paint();
        window.scdTrack?.(liked ? 'project_unlike' : 'project_like', {
          project_slug: slug || '',
          project_title: button.dataset.projectTitle || '',
          project_url: button.dataset.projectUrl || '',
          project_repo: button.dataset.projectRepo || '',
          content_type: 'web_app'
        });
      });
    });
    })();
  </script>
</section>
