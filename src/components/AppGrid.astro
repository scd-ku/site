---
const { apps } = Astro.props;
const tags = [...new Set(apps.flatMap((app) => app.tags))].sort((a, b) => a.localeCompare(b, 'en'));
const base = import.meta.env.BASE_URL;
const asset = (p) => `${base}${p.replace(/^\//, '')}`;
const goethePalette = [
  '#b64f56', // red
  '#c37043', // orange
  '#a88424', // yellow / ochre
  '#5f7d63', // green
  '#50738e', // blue
  '#725f7f', // violet
];
const colorForApp = (slug, index) => {
  const seed = [...slug].reduce((sum, ch) => sum + ch.charCodeAt(0), 0) + index * 17;
  return goethePalette[seed % goethePalette.length];
};
---
<section id="projects" class="projects-section">
  <div class="section-heading">
    <div>
      <h2>Projects</h2>
    </div>
    <div class="display-settings">
      <button class="display-settings-button" type="button" aria-expanded="false" aria-controls="display-settings-popover" title="Color display settings">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="6" cy="7" r="2.2"/><path d="M8.2 7H21"/>
          <circle cx="16" cy="12" r="2.2"/><path d="M3 12h10.8M18.2 12H21"/>
          <circle cx="9" cy="17" r="2.2"/><path d="M3 17h3.8M11.2 17H21"/>
        </svg>
      </button>
      <div class="display-settings-popover" id="display-settings-popover" hidden>
        <div class="display-settings-title">Display</div>
        <div class="settings-group">
          <div class="settings-group-label">Color</div>
          <div class="palette-modes" role="group" aria-label="Color mode">
            <button type="button" data-palette-mode="color" class="is-active">Color</button>
            <button type="button" data-palette-mode="mono">Mono</button>
            <button type="button" data-palette-mode="blind">Blind</button>
            <button type="button" data-palette-mode="redblue">Red / Blue</button>
          </div>
        </div>

        <div class="settings-group">
          <div class="settings-group-label">Columns</div>
          <div class="layout-modes layout-modes--columns" role="group" aria-label="Project columns">
            <button type="button" data-grid-columns="3">3</button>
            <button type="button" data-grid-columns="4" class="is-active">4</button>
            <button type="button" data-grid-columns="5">5</button>
          </div>
        </div>

        <div class="settings-group">
          <div class="settings-group-label">Tiles</div>
          <div class="layout-modes layout-modes--tiles" role="group" aria-label="Tile composition">
            <button type="button" data-tile-layout="ratio" class="is-active">4 : 3</button>
            <button type="button" data-tile-layout="square">Square</button>
            <button type="button" data-tile-layout="mondrian">Composite</button>
          </div>
        </div>

        <label class="saturation-control">
          <span data-screen-label>Description saturation</span>
          <input type="range" min="0" max="100" value="72" step="1" data-detail-saturation />
          <output data-detail-saturation-value>72%</output>
        </label>

        <div class="settings-group settings-group--cursor">
          <div class="settings-group-label">Cursor</div>
          <div class="layout-modes layout-modes--cursor" role="group" aria-label="Cursor mode">
            <button type="button" data-cursor-style="stripe" class="is-active">Stripe</button>
            <button type="button" data-cursor-style="volvox">Volvox</button>
            <button type="button" data-cursor-style="pulse">Circle</button>
            <button type="button" data-cursor-style="line">Line</button>
          </div>
          <label class="cursor-control">
            <span data-cursor-slider1-label>Motion</span>
            <input type="range" min="0" max="100" value="54" step="1" data-cursor-slider1 />
            <output data-cursor-slider1-value>54%</output>
          </label>
          <label class="cursor-control">
            <span data-cursor-slider2-label>Size</span>
            <input type="range" min="20" max="110" value="48" step="1" data-cursor-slider2 />
            <output data-cursor-slider2-value>48</output>
          </label>
        </div>
      </div>
    </div>
  </div>

  <div class="filters" aria-label="Project filters">
    <button class="filter is-active" data-filter="all" type="button">All</button>
    {tags.map((tag) => <button class="filter" data-filter={tag} type="button">{tag}</button>)}
  </div>

  <div class="content-band" aria-label="Current content type">
    <span>Public applications</span>
    <span>{apps.length}</span>
  </div>

  <div class="app-grid" id="app-grid">
    {apps.map((app, index) => (
      <article
        class={`app-card app-card--${app.size}`}
        data-tags={JSON.stringify(app.tags)}
        data-slug={app.slug}
        style={`--index:${index};--detail-bg:${colorForApp(app.slug, index)}`}
      >
        <a class="app-open" href={app.url} target="_blank" rel="noreferrer" aria-label={`${app.title} を開く`} data-project-open={app.slug}>
          <div class="card-visual" aria-hidden="true">
            <div class="fallback-art">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{app.title}</strong>
            </div>
            <img
              src={asset(`screenshots/${app.slug}.jpg`)}
              alt=""
              loading="lazy"
              onerror="this.style.display='none'"
            />
          </div>
          <div class="card-shade"></div>
          <div class="card-label">
            <div>
              <span class="card-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="card-title">{app.title}</span>
            </div>
            <span class="arrow">↗</span>
          </div>
          <div class="card-detail">
            <div class="detail-topline">
              <span>{app.repo}</span>
              <span>Open app ↗</span>
            </div>
            <p>{app.description}</p>
            <div class="card-meta">
              <span>{app.tags.join(' · ')}</span>
              {app.updatedAt && <span>{new Date(app.updatedAt).getFullYear()}</span>}
            </div>
          </div>
        </a>
        <button class="like-button" type="button" data-like={app.slug} aria-pressed="false" aria-label={`${app.title} にいいね`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"/></svg>
        </button>
      </article>
    ))}
  </div>

  <script is:inline>
    const filters = [...document.querySelectorAll('.filter')];
    const cards = [...document.querySelectorAll('.app-card')];

    filters.forEach((button) => {
      button.addEventListener('click', () => {
        const selected = button.dataset.filter;
        filters.forEach((b) => b.classList.toggle('is-active', b === button));
        cards.forEach((card) => {
          const tags = JSON.parse(card.dataset.tags || '[]');
          const visible = selected === 'all' || tags.includes(selected);
          card.classList.toggle('is-filtered-out', !visible);
          window.setTimeout(() => card.toggleAttribute('hidden', !visible), visible ? 0 : 180);
        });
      });
    });

    cards.forEach((card) => {
      card.addEventListener('pointerenter', () => document.body.dataset.cursor = 'open');
      card.addEventListener('pointerleave', () => delete document.body.dataset.cursor);
    });

    document.querySelectorAll('[data-project-open]').forEach((link) => {
      link.addEventListener('click', () => {
        window.scdTrack?.('project_open', { project_slug: link.dataset.projectOpen });
      });
    });

    const settingsButton = document.querySelector('.display-settings-button');
    const settingsPopover = document.querySelector('.display-settings-popover');
    const paletteButtons = [...document.querySelectorAll('[data-palette-mode]')];
    const columnButtons = [...document.querySelectorAll('[data-grid-columns]')];
    const tileLayoutButtons = [...document.querySelectorAll('[data-tile-layout]')];
    const saturationSlider = document.querySelector('[data-detail-saturation]');
    const saturationValue = document.querySelector('[data-detail-saturation-value]');
    const screenLabel = document.querySelector('[data-screen-label]');
    const cursorButtons = [...document.querySelectorAll('[data-cursor-style]')];
    const cursorSlider1 = document.querySelector('[data-cursor-slider1]');
    const cursorSlider2 = document.querySelector('[data-cursor-slider2]');
    const cursorSlider1Label = document.querySelector('[data-cursor-slider1-label]');
    const cursorSlider2Label = document.querySelector('[data-cursor-slider2-label]');
    const cursorSlider1Value = document.querySelector('[data-cursor-slider1-value]');
    const cursorSlider2Value = document.querySelector('[data-cursor-slider2-value]');

    const updateCursorControls = (style, state) => {
      cursorButtons.forEach((button) => button.classList.toggle('is-active', button.dataset.cursorStyle === style));
      if (!cursorSlider1 || !cursorSlider2) return;
      if (style === 'line') {
        cursorSlider1Label.textContent = 'Trail';
        cursorSlider1.min = '0';
        cursorSlider1.max = '100';
        cursorSlider1.value = String(state.trail ?? 42);
        cursorSlider1Value.textContent = `${cursorSlider1.value}%`;
        cursorSlider2Label.textContent = 'Hue';
        cursorSlider2.min = '0';
        cursorSlider2.max = '360';
        cursorSlider2.value = String(state.lineHue ?? 210);
        cursorSlider2Value.textContent = `${cursorSlider2.value}°`;
      } else {
        cursorSlider1Label.textContent = style === 'pulse' ? 'Amplitude' : 'Motion';
        cursorSlider1.min = '0';
        cursorSlider1.max = '100';
        cursorSlider1.value = String(state.motion ?? 54);
        cursorSlider1Value.textContent = `${cursorSlider1.value}%`;
        cursorSlider2Label.textContent = 'Size';
        cursorSlider2.min = '20';
        cursorSlider2.max = '110';
        cursorSlider2.value = String(state.size ?? 48);
        cursorSlider2Value.textContent = `${cursorSlider2.value}`;
      }
    };

    const getCursorState = () => ({
      style: localStorage.getItem('scd_cursor_style') || 'stripe',
      motion: Math.max(0, Math.min(100, Number(localStorage.getItem('scd_cursor_motion') || 54))),
      size: Math.max(20, Math.min(110, Number(localStorage.getItem('scd_cursor_size') || 48))),
      lineHue: Math.max(0, Math.min(360, Number(localStorage.getItem('scd_cursor_line_hue') || 210))),
      trail: Math.max(0, Math.min(100, Number(localStorage.getItem('scd_cursor_trail') || 42))),
    });

    const emitCursorState = (state) => {
      document.dispatchEvent(new CustomEvent('scd:update-cursor', { detail: state }));
      updateCursorControls(state.style, state);
    };

    const applyDisplaySettings = (mode, saturation, columns, tileLayout) => {
      document.documentElement.dataset.sitePalette = mode;
      document.documentElement.dataset.projectColumns = columns;
      document.documentElement.dataset.projectLayout = tileLayout;
      document.documentElement.style.setProperty('--detail-saturation', String(0.45 + (saturation / 100) * 1.05));

      paletteButtons.forEach((button) => button.classList.toggle('is-active', button.dataset.paletteMode === mode));
      columnButtons.forEach((button) => button.classList.toggle('is-active', button.dataset.gridColumns === columns));
      tileLayoutButtons.forEach((button) => button.classList.toggle('is-active', button.dataset.tileLayout === tileLayout));

      if (saturationSlider) saturationSlider.value = String(saturation);
      if (saturationValue) saturationValue.textContent = `${saturation}%`;
      if (screenLabel) screenLabel.textContent = mode === 'blind' ? 'Screen tone' : 'Description saturation';

      localStorage.setItem('scd_site_palette', mode);
      localStorage.setItem('scd_detail_saturation', String(saturation));
      localStorage.setItem('scd_project_columns', columns);
      localStorage.setItem('scd_project_layout', tileLayout);
      if (mode === 'blind') {
        document.dispatchEvent(new CustomEvent('scd:update-blind-tone', { detail: { value: saturation } }));
        const currentCursor = getCursorState();
        if (currentCursor.style !== 'pulse') {
          currentCursor.style = 'pulse';
          localStorage.setItem('scd_cursor_style', 'pulse');
          emitCursorState(currentCursor);
        }
      }
    };

    const savedMode = localStorage.getItem('scd_site_palette') || 'color';
    const savedSaturation = Math.max(0, Math.min(100, Number(localStorage.getItem('scd_detail_saturation') || 72)));
    const savedColumns = localStorage.getItem('scd_project_columns') || '4';
    const savedTileLayout = localStorage.getItem('scd_project_layout') || 'ratio';
    applyDisplaySettings(savedMode, savedSaturation, savedColumns, savedTileLayout);
    updateCursorControls(getCursorState().style, getCursorState());

    settingsButton?.addEventListener('click', () => {
      const willOpen = settingsPopover?.hasAttribute('hidden');
      settingsPopover?.toggleAttribute('hidden', !willOpen);
      settingsButton.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
    });
    paletteButtons.forEach((button) => button.addEventListener('click', () => {
      applyDisplaySettings(
        button.dataset.paletteMode || 'color',
        Number(saturationSlider?.value || 100),
        document.documentElement.dataset.projectColumns || '4',
        document.documentElement.dataset.projectLayout || 'ratio'
      );
    }));
    columnButtons.forEach((button) => button.addEventListener('click', () => {
      applyDisplaySettings(
        document.documentElement.dataset.sitePalette || 'color',
        Number(saturationSlider?.value || 100),
        button.dataset.gridColumns || '3',
        document.documentElement.dataset.projectLayout || 'ratio'
      );
    }));
    tileLayoutButtons.forEach((button) => button.addEventListener('click', () => {
      applyDisplaySettings(
        document.documentElement.dataset.sitePalette || 'color',
        Number(saturationSlider?.value || 100),
        document.documentElement.dataset.projectColumns || '4',
        button.dataset.tileLayout || 'ratio'
      );
    }));
    saturationSlider?.addEventListener('input', () => {
      applyDisplaySettings(
        document.documentElement.dataset.sitePalette || 'color',
        Number(saturationSlider.value),
        document.documentElement.dataset.projectColumns || '4',
        document.documentElement.dataset.projectLayout || 'ratio'
      );
      if ((document.documentElement.dataset.sitePalette || 'color') === 'blind') {
        document.dispatchEvent(new CustomEvent('scd:update-blind-tone', { detail: { value: Number(saturationSlider.value) } }));
      }
    });

    cursorButtons.forEach((button) => button.addEventListener('click', () => {
      const state = getCursorState();
      state.style = button.dataset.cursorStyle || 'stripe';
      emitCursorState(state);
    }));
    cursorSlider1?.addEventListener('input', () => {
      const state = getCursorState();
      if (state.style === 'line') {
        state.trail = Number(cursorSlider1.value);
      } else {
        state.motion = Number(cursorSlider1.value);
      }
      emitCursorState(state);
    });
    cursorSlider2?.addEventListener('input', () => {
      const state = getCursorState();
      if (state.style === 'line') {
        state.lineHue = Number(cursorSlider2.value);
      } else {
        state.size = Number(cursorSlider2.value);
      }
      emitCursorState(state);
    });
    document.addEventListener('pointerdown', (event) => {
      if (!settingsPopover || settingsPopover.hasAttribute('hidden')) return;
      if (!event.target.closest('.display-settings')) {
        settingsPopover.setAttribute('hidden', '');
        settingsButton?.setAttribute('aria-expanded', 'false');
      }
    });

    document.querySelectorAll('[data-like]').forEach((button) => {
      const slug = button.dataset.like;
      const key = `scd_like_${slug}`;
      const paint = () => {
        const liked = localStorage.getItem(key) === '1';
        button.setAttribute('aria-pressed', liked ? 'true' : 'false');
        button.classList.toggle('is-liked', liked);
      };
      paint();
      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        const liked = localStorage.getItem(key) === '1';
        localStorage.setItem(key, liked ? '0' : '1');
        paint();
        window.scdTrack?.(liked ? 'project_unlike' : 'project_like', { project_slug: slug });
      });
    });
  </script>
</section>
