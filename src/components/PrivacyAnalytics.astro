---
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '';
---
<div class="privacy-ui" data-ga-id={gaId}>
  <div class="privacy-banner" id="privacy-banner" hidden>
    <p>
      このサイトでは、利用状況の改善のため Google Analytics を利用します。許可した場合のみ、参照元、閲覧ページ、おおよその地域、ブラウザ・端末情報等が Google に送信されます。
    </p>
    <div class="privacy-actions">
      <button type="button" data-consent="accept">許可する</button>
      <button type="button" data-consent="deny" class="secondary">拒否する</button>
      <a href="./privacy/">詳しく</a>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('.privacy-ui');
    const banner = document.getElementById('privacy-banner');
    if (!root || !banner) return;
    const gaId = root.dataset.gaId || '';
    const key = 'scd_analytics_consent';
    let loaded = false;

    window.scdTrack = (...args) => {
      if (typeof window.gtag === 'function') window.gtag('event', ...args);
    };

    const loadAnalytics = () => {
      if (!gaId || loaded) return;
      loaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function(){ window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', gaId, {
        send_page_view: true,
        allow_google_signals: false,
        allow_ad_personalization_signals: false
      });
      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`;
      document.head.appendChild(script);
    };

    const clearGaCookies = () => {
      document.cookie.split(';').forEach((item) => {
        const name = item.split('=')[0]?.trim();
        if (name && (name === '_ga' || name.startsWith('_ga_'))) {
          document.cookie = `${name}=; Max-Age=0; path=/; SameSite=Lax`;
        }
      });
    };

    const setConsent = (value) => {
      localStorage.setItem(key, value);
      banner.hidden = true;
      if (value === 'accepted') loadAnalytics();
      if (value === 'denied') clearGaCookies();
    };

    const current = localStorage.getItem(key);
    window.scdAnalyticsStatus = {
      configured: Boolean(gaId),
      consent: current || 'unset'
    };

    if (gaId) {
      if (current === 'accepted') loadAnalytics();
      else if (current !== 'denied') banner.hidden = false;
    } else {
      console.warn('[SCD] Google Analytics is disabled because PUBLIC_GA_MEASUREMENT_ID is not configured at build time.');
    }

    banner.querySelector('[data-consent="accept"]')?.addEventListener('click', () => setConsent('accepted'));
    banner.querySelector('[data-consent="deny"]')?.addEventListener('click', () => setConsent('denied'));

    window.scdOpenPrivacyChoices = () => {
      if (!gaId) return;
      banner.hidden = false;
    };
    window.scdResetAnalyticsConsent = () => {
      localStorage.removeItem(key);
      clearGaCookies();
      if (gaId) banner.hidden = false;
    };
  })();
</script>
