<!--
  Pieris rapae (モンシロチョウ) — schematic, not a photographic tracing.
  References:
  Jantzen & Eisner 2008: intact P. rapae ~11.8 wingbeats/sec (PMC2575472).
  Suzuki et al. 2023: fore/hind wing motion and variable flap amplitude.
  Shkurikhin et al. 2024: curved 3D trajectories of Pieris forms (DOI:10.1002/ece3.70012).
  Four broad, rounded wings; forewings are somewhat larger than hindwings.
-->
<div class="scd-butterfly" data-scd-butterfly aria-hidden="true">
  <svg viewBox="0 0 120 85" xmlns="http://www.w3.org/2000/svg" focusable="false">
    <g class="scd-butterfly-wing scd-butterfly-left">
      <!-- Left forewing: long leading edge and rounded apex -->
      <path d="M58 42 C49 29 37 12 19 8 C7 5 2 16 8 31 C16 47 34 52 56 49 Z" />
      <!-- Left hindwing: smaller and distinctly rounder -->
      <path d="M57 48 C47 49 34 45 25 52 C18 58 22 70 34 73 C46 75 54 62 59 51 Z" />
    </g>
    <g class="scd-butterfly-wing scd-butterfly-right">
      <path d="M62 42 C71 29 83 12 101 8 C113 5 118 16 112 31 C104 47 86 52 64 49 Z" />
      <path d="M63 48 C73 49 86 45 95 52 C102 58 98 70 86 73 C74 75 66 62 61 51 Z" />
    </g>
    <!-- Head, clubbed antennae, slender thorax and abdomen -->
    <path class="scd-butterfly-body" d="M60 25 C54 25 54 33 56 38 C54 46 56 59 59 73 Q60 78 61 73 C64 59 66 46 64 38 C66 33 66 25 60 25 Z" />
    <path class="scd-butterfly-antenna" d="M58 27 C52 19 49 12 47 6 M62 27 C68 19 71 12 73 6" />
    <circle cx="47" cy="6" r="1.7" /><circle cx="73" cy="6" r="1.7" />
  </svg>
</div>

<style>
  .scd-butterfly {
    display:none;
    position:fixed;
    top:0;
    left:0;
    width:56px;
    height:40px;
    z-index:80;
    pointer-events:none;
    color:#111;
    transform-origin:50% 50%;
    will-change:transform;
  }
  .scd-butterfly svg { display:block; width:100%; height:100%; overflow:visible; }
  .scd-butterfly path:not(.scd-butterfly-antenna),
  .scd-butterfly circle { fill:currentColor; }
  .scd-butterfly-antenna {
    fill:none; stroke:currentColor; stroke-width:1.6; stroke-linecap:round;
  }
  .scd-butterfly-wing {
    transform-box:view-box;
    transform-origin:60px 45px;
    transform:scaleX(.82);
    will-change:transform;
  }
  /* Wing coupling: the forewing and hindwing of each side move together.
     The 85ms period during bursts approximates the measured ~11.8 Hz.
     Between bursts, wings remain partially spread as a stylized float. */
  .scd-butterfly.is-flapping .scd-butterfly-wing {
    animation:scd-wingbeat .085s ease-in-out infinite;
  }
  @keyframes scd-wingbeat {
    0%,100% { transform:scaleX(.20); }
    50% { transform:scaleX(1); }
  }
  @media (prefers-reduced-motion:reduce) {
    .scd-butterfly { display:none !important; }
    .scd-butterfly-wing { animation:none !important; }
  }
</style>

<script>
  (() => {
    const el = document.querySelector('[data-scd-butterfly]');
    const hero = document.querySelector('.hero');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!el || reduceMotion.matches) return;

    const rand = (a,b) => a + Math.random() * (b-a);
    const clamp = (v,a,b) => Math.max(a,Math.min(b,v));
    let visitTimer = 0, wingTimer = 0, raf = 0, flying = false;

    const scheduleVisit = () => {
      clearTimeout(visitTimer);
      if (!reduceMotion.matches) {
        visitTimer = window.setTimeout(startVisit, rand(26000,52000));
      }
    };

    const stopVisit = () => {
      flying = false;
      cancelAnimationFrame(raf);
      clearTimeout(wingTimer);
      el.style.display = 'none';
      el.classList.remove('is-flapping');
      scheduleVisit();
    };

    const planWingbeat = (burst = false) => {
      clearTimeout(wingTimer);
      if (!flying) return;
      // Short flapping bursts alternate with longer, slower-looking drifts.
      // Intended as an artistic interpretation, not a physical gliding model.
      el.classList.toggle('is-flapping',burst);
      wingTimer = window.setTimeout(() => planWingbeat(!burst),
        burst ? rand(180,520) : rand(700,1750));
    };

    // Catmull-Rom spline: passing through softly turning waypoints. Two local
    // reversals and varied elevations avoid a straight horizontal traversal.
    const spline = (p0,p1,p2,p3,t) => {
      const t2=t*t,t3=t2*t;
      return {
        x: .5*((2*p1.x)+(-p0.x+p2.x)*t+
          (2*p0.x-5*p1.x+4*p2.x-p3.x)*t2+
          (-p0.x+3*p1.x-3*p2.x+p3.x)*t3),
        y: .5*((2*p1.y)+(-p0.y+p2.y)*t+
          (2*p0.y-5*p1.y+4*p2.y-p3.y)*t2+
          (-p0.y+3*p1.y-3*p2.y+p3.y)*t3)
      };
    };
    const samplePath = (points,u) => {
      const n=points.length-1;
      const v=clamp(u,0,1)*n;
      const i=Math.min(n-1,Math.floor(v));
      const t=v-i;
      // Smoothstep lets the butterfly linger gently near direction changes.
      const eased=t*t*(3-2*t);
      return spline(
        points[Math.max(0,i-1)],points[i],
        points[i+1],points[Math.min(n,i+2)],eased
      );
    };

    const startVisit = () => {
      if (reduceMotion.matches || document.hidden || flying) { scheduleVisit(); return; }
      const width=window.innerWidth, height=window.innerHeight;
      const heroBottom=hero?.getBoundingClientRect().bottom ?? -1;
      const yMin=clamp(heroBottom+38,35,height-85);
      const yMax=height-68;
      if (yMax-yMin<120) { scheduleVisit(); return; }

      const rightToLeft=Math.random()<.5;
      const direction=rightToLeft?-1:1;
      const span=yMax-yMin;
      const xStops=[-.09,.18,.39,.25,.61,.84,.66,1.10];
      const yStops=[.50,.28,.72,.82,.24,.16,.64,.39];
      const points=xStops.map((v,i) => ({
        x: direction===1
          ? v*width + (i===0||i===7?0:rand(-.06,.06)*width)
          : width-v*width + (i===0||i===7?0:rand(-.06,.06)*width),
        y: yMin+clamp(yStops[i]+rand(-.11,.11),.06,.94)*span
      }));
      const duration=rand(20500,28500);
      const start=performance.now();
      const phase=rand(0,Math.PI*2);
      flying=true;
      el.style.display='block';
      planWingbeat(false);

      let previousAngle=direction===1?90:-90;
      const step=(now) => {
        if(document.hidden || reduceMotion.matches){stopVisit();return;}
        const u=clamp((now-start)/duration,0,1);
        const pt=samplePath(points,u);
        const before=samplePath(points,Math.max(0,u-.003));
        const after=samplePath(points,Math.min(1,u+.003));
        const vx=after.x-before.x, vy=after.y-before.y;

        // Very slow breeze-induced swaying without violent fluttering.
        const windX=13*Math.sin(2*Math.PI*u*2.1+phase)*Math.sin(Math.PI*u);
        const windY=8*Math.sin(2*Math.PI*u*3.3+phase*.7);
        const x=pt.x+windX,y=clamp(pt.y+windY,yMin,yMax);
        if(Math.hypot(vx,vy)>1) {
          const desired=Math.atan2(vy,vx)*180/Math.PI+90;
          // Shortest path between angles; avoid sudden flips at turns.
          const delta=((desired-previousAngle+540)%360)-180;
          previousAngle+=delta*.10;
        }
        const roll=5*Math.sin(2*Math.PI*u*4.1+phase);
        el.style.transform=
          `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0) rotate(${(previousAngle+roll).toFixed(1)}deg)`;

        // The silhouette remains black, so hide it on the dark hero surface.
        const currentHeroBottom=hero?.getBoundingClientRect().bottom ?? -1;
        el.style.visibility=y<currentHeroBottom+22?'hidden':'visible';

        if(u<1) raf=requestAnimationFrame(step);
        else stopVisit();
      };
      raf=requestAnimationFrame(step);
    };

    scheduleVisit();
    document.addEventListener('visibilitychange',()=>{
      if(document.hidden && flying)stopVisit();
    });
    reduceMotion.addEventListener('change',()=>{
      if(reduceMotion.matches){
        clearTimeout(visitTimer);
        if(flying)stopVisit();
        clearTimeout(visitTimer);
      } else if(!flying) scheduleVisit();
    });
  })();
</script>
