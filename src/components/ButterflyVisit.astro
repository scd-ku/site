---
/**
 * Butterflies from pinned dorsal specimens (NSG group, Lund; CC0).
 * Papilio xuthus: https://commons.wikimedia.org/wiki/File:MZLU-00129145_dorsal_(51008259851).jpg
 * Pieris rapae: https://commons.wikimedia.org/wiki/File:MZLU-00129165_dorsal_(51008850721).jpg
 * External Wikimedia thumbnails are used only for the photographic reveal.
 * Four independently traced wing outlines reproduce the specimen's distinctive
 * scalloped margins, swallowtail tips and different fore/hindwing proportions.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const photos = {
  papilio: existsSync(join(process.cwd(), 'public/butterflies/papilio-xuthus.jpg'))
    ? base + 'butterflies/papilio-xuthus.jpg'
    : 'https://upload.wikimedia.org/wikipedia/commons/thumb/b/ba/MZLU-00129145_dorsal_%2851008259851%29.jpg/960px-MZLU-00129145_dorsal_%2851008259851%29.jpg',
  pieris: existsSync(join(process.cwd(), 'public/butterflies/pieris-rapae.jpg'))
    ? base + 'butterflies/pieris-rapae.jpg'
    : 'https://upload.wikimedia.org/wikipedia/commons/thumb/1/10/MZLU-00129165_dorsal_%2851008850721%29.jpg/960px-MZLU-00129165_dorsal_%2851008850721%29.jpg'
};
const forms = {
  papilio: {
    view:'105 0 795 640',
    ratio:640/795,
    leftFore:'M511 283 C479 213 421 143 353 97 C289 48 219 13 176 12 Q139 4 142 32 C145 64 164 93 178 130 C191 164 192 197 215 222 Q233 279 267 285 C324 294 428 290 511 301 Z',
    leftHind:'M505 283 C459 281 396 285 340 299 Q289 311 270 333 L255 353 Q255 365 266 373 L244 397 Q235 408 247 418 L263 441 Q247 453 260 468 L285 486 Q266 499 285 517 Q270 540 259 557 L221 596 Q219 610 236 600 L299 541 Q323 530 348 542 Q364 559 382 546 Q397 558 417 526 C436 481 448 426 459 368 C473 323 487 301 505 283 Z',
    rightFore:'M541 283 C572 217 640 144 711 97 C780 46 840 13 864 15 Q892 13 884 45 C883 88 866 111 862 139 Q855 188 832 222 C829 254 814 282 782 291 C720 295 627 288 541 302 Z',
    rightHind:'M541 286 C599 284 661 287 711 302 Q748 311 762 341 L776 358 Q789 369 773 381 L786 398 Q790 412 775 421 L788 437 Q785 449 773 458 L788 480 Q782 492 767 499 Q779 519 765 527 L788 556 L809 579 Q817 595 805 590 L772 565 Q748 548 731 548 Q708 550 691 559 Q675 560 667 544 Q653 558 637 537 C616 474 612 421 595 359 C578 321 558 297 541 286 Z',
    body:'M516 226 C510 216 500 224 497 237 C491 256 491 289 495 305 C499 338 505 387 510 424 Q514 443 520 423 C531 362 528 311 528 286 C537 269 533 236 527 228 Z',
    antenna:'M508 233 Q477 185 443 129 M520 233 Q556 184 592 137',
    antennaEnds:[[443,129],[592,137]]
  },
  pieris: {
    view:'165 15 710 470',
    ratio:470/710,
    leftFore:'M503 232 C456 170 389 114 323 73 Q229 21 201 31 Q179 33 186 70 L187 110 Q187 147 205 183 C220 222 246 236 292 240 C376 244 462 248 503 253 Z',
    leftHind:'M501 250 C437 249 378 246 329 252 Q267 265 240 298 Q211 326 221 350 C237 406 298 455 365 470 Q411 480 445 434 C473 393 493 330 501 268 Z',
    rightFore:'M530 232 C579 167 649 105 713 67 Q792 19 832 32 Q853 37 848 72 L848 117 Q845 167 819 203 Q797 238 737 240 C651 245 571 246 530 253 Z',
    rightHind:'M531 250 C594 245 652 246 710 254 Q770 268 807 306 Q832 333 825 354 C808 421 744 458 674 457 Q615 456 574 404 C545 370 537 317 531 268 Z',
    body:'M510 200 Q496 202 494 225 C483 249 489 267 495 287 Q499 330 509 403 Q517 421 524 404 Q534 336 533 285 C540 260 540 229 529 215 Q523 203 510 200 Z',
    antenna:'M505 210 Q489 170 464 39 M519 210 Q555 130 570 44',
    antennaEnds:[[464,39],[570,44]]
  }
};
// Three independently flying Pieris, plus one longer-staying Papilio.
const butterflies = [{kind:'pieris',key:'p0'},{kind:'pieris',key:'p1'},{kind:'pieris',key:'p2'},{kind:'papilio',key:'a0'}];
function renderSvg(kind,key,photographic) {
  const f=forms[kind];
  const id='scd-mask-'+key;
  const wings=[['left',f.leftFore,f.leftHind],['right',f.rightFore,f.rightHind]];
  // Each photographic wing is masked independently. A black mask cutout at
  // the thorax removes wing texture from the body region before the final,
  // single, opaque body is drawn above both wings.
  const masks=photographic
    ? '<defs>'+wings.map(([side,fore,hind])=>
        '<mask id="'+id+'-'+side+'" maskUnits="userSpaceOnUse" maskContentUnits="userSpaceOnUse" x="0" y="0" width="960" height="720" style="mask-type:luminance">'+
        '<path d="'+fore+'" style="fill:#fff"/><path d="'+hind+'" style="fill:#fff"/>'+
        '<path d="'+f.body+'" style="fill:#000"/></mask>').join('')+'</defs>'
    : '';
  const wingMarkup=wings.map(([side,fore,hind])=>{
    const interior=photographic
      ? '<image x="0" y="0" width="960" height="720" preserveAspectRatio="none" href="'+photos[kind]+'" mask="url(#'+id+'-'+side+')"/>'
      : '<path d="'+fore+'"/><path d="'+hind+'"/>';
    return '<g class="scd-butterfly-wing scd-butterfly-'+side+'">'+interior+'</g>';
  }).join('');
  // Draw the body only once in the foreground. Keeping it an opaque shape
  // (rather than a second image clip) also prevents duplicate thoraxes
  // during rapid wingbeats and when Lens overlays the underlying silhouette.
  const body='<path class="scd-butterfly-body" d="'+f.body+'"/>';
  const antenna='<path class="scd-butterfly-antenna" d="'+f.antenna+'"/>'+
    f.antennaEnds.map(([x,y])=>'<circle cx="'+x+'" cy="'+y+'" r="2"/>').join('');
  return '<svg viewBox="'+f.view+'" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">'+
    masks+wingMarkup+body+antenna+'</svg>';
}
---
<!-- The first layer lives in DOCUMENT coordinates; it naturally scrolls with the site. -->
<div class="scd-butterfly-layer" data-scd-butterfly-layer aria-hidden="true">
  {butterflies.map((b)=>(
    <div class={'scd-butterfly scd-butterfly--'+b.kind} data-scd-butterfly={b.kind} data-butterfly-key={b.key} set:html={renderSvg(b.kind,b.key,false)}></div>
  ))}
</div>
<!-- The photo layer is clipped to the cursor aperture and floats above Lens/Invert.
     The photos retain the same contour, wing animation and orientation as silhouettes. -->
<div class="scd-butterfly-photo-layer" data-scd-butterfly-photo-layer aria-hidden="true">
  {butterflies.map((b)=>(
    <div class={'scd-butterfly scd-butterfly--'+b.kind+' scd-butterfly--photo'} data-butterfly-photo={b.key} set:html={renderSvg(b.kind,b.key,true)}></div>
  ))}
</div>

<style>
  .scd-butterfly-layer {
    position:absolute;
    top:0;
    left:0;
    width:100%;
    pointer-events:none;
    z-index:80;
    overflow:visible;
  }
  .scd-butterfly-photo-layer {
    position:fixed;
    inset:0;
    z-index:1002;
    pointer-events:none;
    overflow:hidden;
    visibility:hidden;
  }
  .scd-butterfly {
    position:absolute;
    top:0;left:0;
    display:none;
    color:#101010;
    pointer-events:none;
    transform-origin:50% 50%;
    will-change:transform;
  }
  .scd-butterfly--pieris { width:56px;height:37px; }
  .scd-butterfly--papilio { width:92px;height:74px; }
  :global(.scd-butterfly svg) { display:block;width:100%;height:100%;overflow:visible; }
  :global(.scd-butterfly path:not(.scd-butterfly-antenna)),
  :global(.scd-butterfly circle) {fill:currentColor}
  :global(.scd-butterfly-antenna) {
    fill:none;stroke:currentColor;stroke-width:3.3;stroke-linecap:round;
  }
  :global(.scd-butterfly-wing) {
    transform-box:view-box;
    transform-origin:center;
    transform:scaleX(.85);
    will-change:transform;
  }
  :global(.scd-butterfly.is-flapping .scd-butterfly-wing) {
    animation:scd-butterfly-beat var(--wing-period,.085s) ease-in-out infinite;
  }
  :global(.scd-butterfly--photo .scd-butterfly-wing) {animation:none!important}
  :global(.scd-butterfly-body) { fill:currentColor; }
  /* Photographic wings are cut away at the body; opaque thorax is drawn last. */
  @keyframes scd-butterfly-beat {
    0%,100% {transform:scaleX(.2)}
    50% {transform:scaleX(1)}
  }
  @media(prefers-reduced-motion:reduce) {
    .scd-butterfly-layer,.scd-butterfly-photo-layer {display:none!important}
  }
</style>

<script>
(() => {
  const layer=document.querySelector('[data-scd-butterfly-layer]');
  const photos=document.querySelector('[data-scd-butterfly-photo-layer]');
  const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
  const hero=document.querySelector('.hero');
  if(!layer||!photos)return;
  const TAU=2*Math.PI;
  const random=(a,b)=>a+Math.random()*(b-a);
  const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
  const props={
    pieris:{
      size:[48,61],ratio:470/710,frequency:11.8,interval:[21000,48000],
      flight:[17500,25500],bob:3.3,swoop:11,
      x:[-.12,.11,.31,.22,.48,.70,.58,.83,1.11],
      y:[.49,.68,.26,.57,.80,.24,.65,.76,.37],
      flap:[720,1500],pause:[65,190]
    },
    papilio:{
      size:[80,108],ratio:640/795,frequency:10.6,interval:[100000,190000],
      flight:[19000,28500],bob:2.2,swoop:7,
      x:[-.13,.13,.30,.48,.40,.65,.84,1.13],
      y:[.56,.34,.63,.24,.50,.70,.35,.43],
      flap:[1050,1900],pause:[90,260]
    }
  };

  let pointerX=innerWidth/2,pointerY=innerHeight/2,hasPointer=false;
  const drawStates=[];
  function documentSize() {
    const size=Math.max(document.body.scrollHeight,document.documentElement.scrollHeight);
    layer.style.height=size+'px';
    return size;
  }
  documentSize();

  const catmull=(a,b,c,d,t)=>{
    const q=t*t,r=q*t;
    return {x:.5*(2*b.x+(-a.x+c.x)*t+(2*a.x-5*b.x+4*c.x-d.x)*q+(-a.x+3*b.x-3*c.x+d.x)*r),
      y:.5*(2*b.y+(-a.y+c.y)*t+(2*a.y-5*b.y+4*c.y-d.y)*q+(-a.y+3*b.y-3*c.y+d.y)*r)};
  };
  const at=(points,u)=>{
    const last=points.length-1,v=clamp(u,0,1)*last,i=Math.min(last-1,Math.floor(v));
    return catmull(points[Math.max(0,i-1)],points[i],points[i+1],points[Math.min(last,i+2)],v-i);
  };

  const states=[...layer.querySelectorAll('[data-butterfly-key]')].map((el,index)=>{
    const key=el.dataset.butterflyKey,kind=el.dataset.scdButterfly;
    const spec=props[kind];
    const photo=photos.querySelector('[data-butterfly-photo="'+key+'"]');
    const state={index,key,kind,spec,el,photo,timer:0,wingTimer:0,frame:0,
      active:false,x:0,y:0,heading:0,scale:1,w:0,h:0};

    const schedule=(initial=false)=>{
      clearTimeout(state.timer);
      if(reduced.matches)return;
      const delay=initial
        ? kind==='pieris'?(index===0?random(7000,21000):random(24000,45000)):random(90000,165000)
        : random(...spec.interval);
      state.timer=setTimeout(start,delay);
    };
    const wings=(flap)=>{
      if(!state.active)return;
      el.classList.toggle('is-flapping',flap);
      clearTimeout(state.wingTimer);
      state.wingTimer=setTimeout(()=>wings(!flap),flap?random(...spec.flap):random(...spec.pause));
    };
    const stop=()=>{
      state.active=false;
      cancelAnimationFrame(state.frame);
      clearTimeout(state.wingTimer);
      state.frame=0;
      el.style.display='none';
      photo.style.display='none';
      el.classList.remove('is-flapping');
      schedule();
    };
    const start=()=>{
      if(state.active||reduced.matches||document.hidden){schedule();return}
      const pageHeight=documentSize();
      const heroBottom=(hero?.getBoundingClientRect().bottom??-100)+scrollY;
      const minY=Math.max(heroBottom+34,scrollY+65);
      const maxY=Math.min(pageHeight-120,scrollY+innerHeight-(kind==='papilio'?95:65));
      if(maxY-minY<115){schedule();return}
      const width=document.documentElement.clientWidth;
      const reverse=Math.random()<.5;
      const points=spec.x.map((u,i)=>({
        x:(reverse?1-u:u)*width+(i===0||i===spec.x.length-1?0:random(-.045,.045)*width),
        y:minY+clamp(spec.y[i]+random(-.095,.095),.08,.92)*(maxY-minY)
      }));
      const duration=random(...spec.flight),started=performance.now();
      const phase=random(0,TAU),wingPhase=random(0,TAU);
      const w=random(...spec.size),h=w*spec.ratio;
      state.w=w;state.h=h;
      el.style.width=photo.style.width=w+'px';
      el.style.height=photo.style.height=h+'px';
      el.style.setProperty('--wing-period',(1/spec.frequency)+'s');
      el.style.display='block';
      photo.style.display='block';
      state.active=true;
      wings(true);
      let heading=reverse?-90:90;

      function animate(now) {
        if(document.hidden||reduced.matches){stop();return}
        const t=(now-started)*.001,u=clamp((now-started)/duration,0,1);
        const mid=at(points,u);
        const p1=at(points,Math.min(1,u+.0025));
        const p0=at(points,Math.max(0,u-.0025));
        const oscillation=spec.bob*Math.sin(TAU*spec.frequency*t+wingPhase)
          +spec.swoop*Math.sin(TAU*(kind==='pieris'?.82:.59)*t+phase)
          +4*Math.sin(TAU*(kind==='pieris'?1.5:1.05)*t+wingPhase);
        const x=mid.x+7*Math.sin(TAU*(kind==='pieris'?.52:.35)*t+phase);
        const y=clamp(mid.y+oscillation,minY,maxY);
        const vx=p1.x-p0.x,vy=p1.y-p0.y;
        if(Math.hypot(vx,vy)>1){
          const desired=Math.atan2(vy,vx)*180/Math.PI+90;
          heading+=(((desired-heading+540)%360)-180)*(kind==='pieris'?.085:.065);
        }
        const roll=(kind==='pieris'?8:6)*Math.sin(TAU*(kind==='pieris'?1.06:.83)*t+phase)
          +2*Math.sin(TAU*spec.frequency*t+wingPhase);
        const scale=1+.025*Math.sin(TAU*1.65*t+wingPhase);
        state.x=x;state.y=y;state.heading=heading+roll;state.scale=scale;
        el.style.transform='translate3d('+x+'px,'+y+'px,0) rotate('+state.heading+'deg) scale('+scale+')';
        state.frame=u<1?requestAnimationFrame(animate):0;
        if(u>=1)stop();
      }
      state.frame=requestAnimationFrame(animate);
    };
    state.stop=stop;state.schedule=schedule;
    return state;
  });
  drawStates.push(...states);

  function updatePhoto() {
    if(!hasPointer||reduced.matches){photos.style.visibility='hidden';return}
    const mode=document.body.dataset.cursorStyle;
    if(!mode||mode==='none'){photos.style.visibility='hidden';return}
    const rootStyle=getComputedStyle(document.documentElement);
    const cursorSize=parseFloat(rootStyle.getPropertyValue('--cursor-size'))||60;
    const zoom=mode==='pulse'?
      (parseFloat(rootStyle.getPropertyValue('--cursor-zoom'))||1.5):1;
    // Reveal photo texture under all cursor styles; Lens additionally enlarges.
    const radius=mode==='line'?Math.max(14,Math.min(25,cursorSize*.4)):cursorSize*.5;
    photos.style.visibility='visible';
    photos.style.clipPath='circle('+radius+'px at '+pointerX+'px '+pointerY+'px)';
    photos.style.webkitClipPath=photos.style.clipPath;
    let visible=false;

    for(const s of drawStates) {
      if(!s.active){s.photo.style.display='none';continue}
      const cx=s.x+s.w*.5,cy=s.y+s.h*.5-scrollY;
      const screenX=pointerX+(cx-pointerX)*zoom;
      const screenY=pointerY+(cy-pointerY)*zoom;
      const reach=Math.max(s.w,s.h)*zoom*.7+radius;
      if(Math.hypot(screenX-pointerX,screenY-pointerY)>reach) {
        s.photo.style.display='none';continue;
      }
      visible=true;
      s.photo.style.display='block';
      s.photo.style.width=(s.w*zoom)+'px';
      s.photo.style.height=(s.h*zoom)+'px';
      const originX=pointerX+zoom*(s.x-pointerX);
      const originY=pointerY+zoom*(s.y-scrollY-pointerY);
      s.photo.style.transform='translate3d('+originX+'px,'+originY+'px,0) rotate('+
        s.heading+'deg) scale('+s.scale+')';
      const from=s.el.querySelectorAll('.scd-butterfly-wing');
      const to=s.photo.querySelectorAll('.scd-butterfly-wing');
      for(let i=0;i<Math.min(from.length,to.length);i++){
        to[i].style.animation='none';
        to[i].style.transform=getComputedStyle(from[i]).transform;
      }
    }
    photos.style.visibility=visible?'visible':'hidden';
  }

  // Keep document-positioned silhouettes moving with the site on scroll.
  // All photograph coordinates are derived from the *current* viewport.
  window.addEventListener('pointermove',e=>{
    pointerX=e.clientX;pointerY=e.clientY;hasPointer=true;
  },{passive:true});
  window.addEventListener('resize',documentSize,{passive:true});
  const observer=new ResizeObserver(documentSize);
  observer.observe(document.body);
  let photoFrame=0;
  const mirror=()=>{
    updatePhoto();
    photoFrame=requestAnimationFrame(mirror);
  };
  photoFrame=requestAnimationFrame(mirror);
  states.forEach(s=>s.schedule(true));

  document.addEventListener('visibilitychange',()=>{
    if(document.hidden)states.forEach(s=>{if(s.active)s.stop()});
  });
  reduced.addEventListener('change',()=>{
    if(reduced.matches){
      states.forEach(s=>{clearTimeout(s.timer);if(s.active)s.stop();clearTimeout(s.timer)});
      photos.style.visibility='hidden';
    }else states.forEach(s=>{if(!s.active)s.schedule(true)});
  });
})();
</script>
