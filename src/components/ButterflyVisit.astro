<!--
  Pieris rapae (モンシロチョウ) — schematic, not a photographic tracing.
  References:
  Jantzen & Eisner 2008: intact P. rapae ~11.8 wingbeats/sec (PMC2575472).
  Suzuki et al. 2023: fore/hind wing motion and variable flap amplitude.
  Shkurikhin et al. 2024: curved 3D trajectories of Pieris forms (DOI:10.1002/ece3.70012).
  Four broad, rounded wings; forewings are somewhat larger than hindwings.
-->
<div class="scd-butterfly" data-scd-butterfly aria-hidden="true">
  <svg viewBox="0 0 120 85" xmlns="http://www.w3.org/2000/svg" focusable="false">
    <g class="scd-butterfly-wing scd-butterfly-left">
      <!-- Left forewing: long leading edge and rounded apex -->
      <path d="M58 42 C49 29 37 12 19 8 C7 5 2 16 8 31 C16 47 34 52 56 49 Z" />
      <!-- Left hindwing: smaller and distinctly rounder -->
      <path d="M57 48 C47 49 34 45 25 52 C18 58 22 70 34 73 C46 75 54 62 59 51 Z" />
    </g>
    <g class="scd-butterfly-wing scd-butterfly-right">
      <path d="M62 42 C71 29 83 12 101 8 C113 5 118 16 112 31 C104 47 86 52 64 49 Z" />
      <path d="M63 48 C73 49 86 45 95 52 C102 58 98 70 86 73 C74 75 66 62 61 51 Z" />
    </g>
    <!-- Head, clubbed antennae, slender thorax and abdomen -->
    <path class="scd-butterfly-body" d="M60 25 C54 25 54 33 56 38 C54 46 56 59 59 73 Q60 78 61 73 C64 59 66 46 64 38 C66 33 66 25 60 25 Z" />
    <path class="scd-butterfly-antenna" d="M58 27 C52 19 49 12 47 6 M62 27 C68 19 71 12 73 6" />
    <circle cx="47" cy="6" r="1.7" /><circle cx="73" cy="6" r="1.7" />
  </svg>
</div>

<style>
  .scd-butterfly {
    display:none;
    position:fixed;
    top:0;
    left:0;
    width:56px;
    height:40px;
    z-index:80;
    pointer-events:none;
    color:#111;
    transform-origin:50% 50%;
    will-change:transform;
  }
  .scd-butterfly svg { display:block; width:100%; height:100%; overflow:visible; }
  .scd-butterfly path:not(.scd-butterfly-antenna),
  .scd-butterfly circle { fill:currentColor; }
  .scd-butterfly-antenna {
    fill:none; stroke:currentColor; stroke-width:1.6; stroke-linecap:round;
  }
  .scd-butterfly-wing {
    transform-box:view-box;
    transform-origin:60px 45px;
    transform:scaleX(.82);
    transition:transform .10s ease-in-out;
    will-change:transform;
  }
  /* Coupled forewing/hindwing motion. At 85 ms per wingbeat the measured
     11.8Hz rhythm is approximated; brief open-wing pauses are stylized. */
  .scd-butterfly.is-flapping .scd-butterfly-wing {
    animation:scd-wingbeat .085s ease-in-out infinite;
  }
  @keyframes scd-wingbeat {
    0%,100% { transform:scaleX(.20); }
    50% { transform:scaleX(1); }
  }
  @media (prefers-reduced-motion:reduce) {
    .scd-butterfly { display:none !important; }
    .scd-butterfly-wing { animation:none !important; }
  }
</style>

<script>
(() => {
  const butterfly = document.querySelector('[data-scd-butterfly]');
  const hero = document.querySelector('.hero');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  if (!butterfly || reducedMotion.matches) return;

  // Pieris rapae evidence:
  // Jantzen & Eisner (2008), PMC2575472: intact flight ~11.8 +/-2.13 Hz;
  // Shkurikhin et al. (2024), PMC11255373: strong curvature, variable velocity;
  // Suzuki et al. (2023), J. Fluid Sci. Technol. 18: wing and body pitch;
  // Sun et al. (2021), PMID 33662377: coupled fore- and hindwing flapping.
  // Motion is stylized: drift, repeated turns and small bobs are not reconstructed
  // from measured individual 3D trajectory recordings.

  const random = (a,b) => a + Math.random()*(b-a);
  const clamp = (v,a,b) => Math.min(b,Math.max(a,v));
  const TAU = Math.PI*2;
  let visitTimer=0, wingTimer=0, animationFrame=0, flying=false;

  function scheduleNext() {
    clearTimeout(visitTimer);
    if (!reducedMotion.matches)
      visitTimer = setTimeout(startVisit,random(26000,54000));
  }

  function stopVisit() {
    flying=false;
    cancelAnimationFrame(animationFrame);
    clearTimeout(wingTimer);
    butterfly.classList.remove('is-flapping');
    butterfly.style.display='none';
    animationFrame=0;
    scheduleNext();
  }

  function wingCycle(flapping=true) {
    if(!flying) return;
    butterfly.classList.toggle('is-flapping',flapping);
    clearTimeout(wingTimer);
    // 11.8Hz during active wingbeats; a *brief* spread-wing phase (<250ms)
    // breaks the strictly mechanical periodicity without a long 'gliding' pose.
    wingTimer=setTimeout(
      ()=>wingCycle(!flapping),
      flapping?random(720,1700):random(75,205)
    );
  }

  function catmull(p0,p1,p2,p3,t) {
    const t2=t*t,t3=t2*t;
    return {
      x:.5*(2*p1.x+(-p0.x+p2.x)*t+
       (2*p0.x-5*p1.x+4*p2.x-p3.x)*t2+
       (-p0.x+3*p1.x-3*p2.x+p3.x)*t3),
      y:.5*(2*p1.y+(-p0.y+p2.y)*t+
       (2*p0.y-5*p1.y+4*p2.y-p3.y)*t2+
       (-p0.y+3*p1.y-3*p2.y+p3.y)*t3)
    };
  }

  function position(points,t) {
    const count=points.length-1;
    const u=clamp(t,0,1)*count;
    const i=Math.min(count-1,Math.floor(u));
    const phase=u-i;
    // No smoothstep at each waypoint — ensures motion does not stop
    // unnaturally each time the butterfly changes direction.
    return catmull(
      points[Math.max(0,i-1)],
      points[i],points[i+1],
      points[Math.min(count,i+2)],phase
    );
  }

  function startVisit() {
    if (flying || document.hidden || reducedMotion.matches) {
      scheduleNext();return;
    }
    const width=innerWidth,height=innerHeight;
    const heroBottom=hero?.getBoundingClientRect().bottom??-200;
    const lower=clamp(heroBottom+34,36,height-98);
    const upper=height-62;
    if(upper-lower<110) {scheduleNext();return;}

    const reverse=Math.random()<.5;
    const xStops=[-.08,.12,.28,.43,.32,.51,.72,.60,.83,1.10];
    const yStops=[.48,.67,.30,.52,.78,.30,.18,.59,.69,.35];
    const points=xStops.map((pos,i)=>({
      x:(reverse?1-pos:pos)*width + (i===0||i===xStops.length-1?0:random(-.045,.045)*width),
      y:lower+clamp(yStops[i]+random(-.08,.08),.08,.92)*(upper-lower)
    }));

    const duration=random(18000,26500);
    const start=performance.now();
    const swayPhase=random(0,TAU);
    const wingPhase=random(0,TAU);
    let heading=reverse?-90:90;
    flying=true;
    butterfly.style.display='block';
    butterfly.style.visibility='visible';
    wingCycle(true);

    function draw(now) {
      if(reducedMotion.matches||document.hidden) {stopVisit();return;}
      const time=(now-start)*.001;
      const u=clamp((now-start)/duration,0,1);
      const center=position(points,u);
      const before=position(points,Math.max(0,u-.0025));
      const after=position(points,Math.min(1,u+.0025));

      // A visible high-frequency flutter rides on the larger winding path.
      // Beat-related body oscillation is intentionally small; 11.8Hz wings
      // are the primary oscillatory movement.
      const wingBob=3.3*Math.sin(TAU*11.8*time+wingPhase);
      const slowBob=11*Math.sin(TAU*.82*time+swayPhase)
                   +5.5*Math.sin(TAU*1.55*time+.5*swayPhase);
      const sideSway=7*Math.sin(TAU*.53*time+swayPhase)
                    +3*Math.sin(TAU*1.30*time);
      const x=center.x+sideSway;
      const y=clamp(center.y+slowBob+wingBob,lower,upper);

      const dx=after.x-before.x;
      const dy=after.y-before.y;
      if(Math.hypot(dx,dy)>1) {
        const desired=Math.atan2(dy,dx)*180/Math.PI+90;
        const difference=((desired-heading+540)%360)-180;
        heading+=difference*.075;
      }

      // Gentle roll and pitch follow each irregular swoop.
      const flutterAngle=8*Math.sin(TAU*1.05*time+swayPhase)
                        +4*Math.sin(TAU*2.1*time)
                        +2*Math.sin(TAU*11.8*time+wingPhase);
      const scale=1+.035*Math.sin(TAU*1.75*time+wingPhase);
      butterfly.style.transform=
        `translate3d(${x.toFixed(2)}px,${y.toFixed(2)}px,0) rotate(${(heading+flutterAngle).toFixed(2)}deg) scale(${scale.toFixed(3)})`;

      // Keep the black silhouette away from the black hero background.
      const darkBottom=hero?.getBoundingClientRect().bottom??-100;
      butterfly.style.visibility=y<darkBottom+22?'hidden':'visible';

      if(u<1)animationFrame=requestAnimationFrame(draw);
      else stopVisit();
    }
    animationFrame=requestAnimationFrame(draw);
  }

  scheduleNext();
  document.addEventListener('visibilitychange',()=>{
    if(document.hidden && flying)stopVisit();
  });
  reducedMotion.addEventListener('change',()=>{
    if(reducedMotion.matches) {
      clearTimeout(visitTimer);
      if(flying)stopVisit();
      clearTimeout(visitTimer);
    } else if(!flying) scheduleNext();
  });
})();
</script>
