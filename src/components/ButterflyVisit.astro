<!--
  Scientific references: Pieris rapae (PMC2575472, PMC11255373);
  Papilio xuthus (PMC4590450, PMC4657377).
  The silhouettes and free-flight paths are simplified visual interpretations.
-->
<div class="scd-butterfly-layer" data-scd-butterfly-layer aria-hidden="true">
<div class="scd-butterfly scd-butterfly--pieris" data-scd-butterfly="pieris" aria-hidden="true">
  <svg viewBox="0 0 120 85" xmlns="http://www.w3.org/2000/svg" focusable="false">
    <g class="scd-butterfly-wing scd-butterfly-left">
      <!-- Left forewing: long leading edge and rounded apex -->
      <path d="M58 42 C49 29 37 12 19 8 C7 5 2 16 8 31 C16 47 34 52 56 49 Z" />
      <!-- Left hindwing: smaller and distinctly rounder -->
      <path d="M57 48 C47 49 34 45 25 52 C18 58 22 70 34 73 C46 75 54 62 59 51 Z" />
    </g>
    <g class="scd-butterfly-wing scd-butterfly-right">
      <path d="M62 42 C71 29 83 12 101 8 C113 5 118 16 112 31 C104 47 86 52 64 49 Z" />
      <path d="M63 48 C73 49 86 45 95 52 C102 58 98 70 86 73 C74 75 66 62 61 51 Z" />
    </g>
    <!-- Head, clubbed antennae, slender thorax and abdomen -->
    <path class="scd-butterfly-body" d="M60 25 C54 25 54 33 56 38 C54 46 56 59 59 73 Q60 78 61 73 C64 59 66 46 64 38 C66 33 66 25 60 25 Z" />
    <path class="scd-butterfly-antenna" d="M58 27 C52 19 49 12 47 6 M62 27 C68 19 71 12 73 6" />
    <circle cx="47" cy="6" r="1.7" /><circle cx="73" cy="6" r="1.7" />
  </svg>
</div>
<div class="scd-butterfly scd-butterfly--pieris" data-scd-butterfly="pieris" aria-hidden="true">
  <svg viewBox="0 0 120 85" xmlns="http://www.w3.org/2000/svg" focusable="false">
    <g class="scd-butterfly-wing scd-butterfly-left">
      <!-- Left forewing: long leading edge and rounded apex -->
      <path d="M58 42 C49 29 37 12 19 8 C7 5 2 16 8 31 C16 47 34 52 56 49 Z" />
      <!-- Left hindwing: smaller and distinctly rounder -->
      <path d="M57 48 C47 49 34 45 25 52 C18 58 22 70 34 73 C46 75 54 62 59 51 Z" />
    </g>
    <g class="scd-butterfly-wing scd-butterfly-right">
      <path d="M62 42 C71 29 83 12 101 8 C113 5 118 16 112 31 C104 47 86 52 64 49 Z" />
      <path d="M63 48 C73 49 86 45 95 52 C102 58 98 70 86 73 C74 75 66 62 61 51 Z" />
    </g>
    <!-- Head, clubbed antennae, slender thorax and abdomen -->
    <path class="scd-butterfly-body" d="M60 25 C54 25 54 33 56 38 C54 46 56 59 59 73 Q60 78 61 73 C64 59 66 46 64 38 C66 33 66 25 60 25 Z" />
    <path class="scd-butterfly-antenna" d="M58 27 C52 19 49 12 47 6 M62 27 C68 19 71 12 73 6" />
    <circle cx="47" cy="6" r="1.7" /><circle cx="73" cy="6" r="1.7" />
  </svg>
</div>
<div class="scd-butterfly scd-butterfly--papilio" data-scd-butterfly="papilio" aria-hidden="true">
  <svg viewBox="0 0 150 116" xmlns="http://www.w3.org/2000/svg" focusable="false">
    <g class="scd-butterfly-wing scd-butterfly-left">
      <!-- Papilio xuthus (Asian swallowtail): pointed forewing, scalloped hindwing, one slender tail per hindwing. Shape compared with dorsal museum specimen photography. -->
      <!-- Dorsal specimen proportions: long triangular forewing, rounded tip, swept outer margin. -->
      <path d="M74 52 C56 32 38 15 20 7 C12 4 7 7 7 16 C7 30 16 44 28 52 C42 62 57 62 75 62 Z"/>
      <!-- Wavy hindwing margin and one long, narrow, OUTWARD tail on the rear outer lobe. -->
      <path d="M75 62 C61 62 49 61 39 65 L32 70 Q28 72 30 77 L23 81 Q19 84 23 88 L17 92 Q13 96 19 99 L11 109 L4 116 Q3 120 7 119 L15 112 L27 102 Q32 105 38 100 L44 96 Q49 98 54 93 L62 87 Q70 82 75 70 Z"/>
    </g>
    <g class="scd-butterfly-wing scd-butterfly-right">
      <path d="M76 52 C94 32 112 15 130 7 C138 4 143 7 143 16 C143 30 134 44 122 52 C108 62 93 62 75 62 Z"/>
      <path d="M75 62 C89 62 101 61 111 65 L118 70 Q122 72 120 77 L127 81 Q131 84 127 88 L133 92 Q137 96 131 99 L139 109 L146 116 Q147 120 143 119 L135 112 L123 102 Q118 105 112 100 L106 96 Q101 98 96 93 L88 87 Q80 82 75 70 Z"/>
    </g>
    <path d="M75 29 C69 29 68 36 70 42 C69 53 69 75 74 92 Q75 99 76 92 C81 75 81 53 80 42 C82 36 81 29 75 29 Z"/>
    <path class="scd-butterfly-antenna" d="M72 30 C65 20 62 12 60 5 M78 30 C85 20 88 12 90 5"/>
    <circle cx="60" cy="5" r="1.8"/><circle cx="90" cy="5" r="1.8"/>
  </svg>
</div>
</div>

<style>
  .scd-butterfly-layer {
    position:fixed;
    inset:0;
    z-index:80;
    pointer-events:none;
    overflow:visible;
  }
  .scd-butterfly {
    display:none;
    position:absolute;
    top:0;
    left:0;
    color:#111;
    pointer-events:none;
    transform-origin:50% 50%;
    will-change:transform;
  }
  .scd-butterfly--pieris {width:55px;height:39px}
  .scd-butterfly--papilio {width:86px;height:67px}
  .scd-butterfly svg {display:block;width:100%;height:100%;overflow:visible}
  .scd-butterfly path:not(.scd-butterfly-antenna),
  .scd-butterfly circle {fill:currentColor}
  .scd-butterfly-antenna {
    fill:none;
    stroke:currentColor;
    stroke-width:1.6;
    stroke-linecap:round;
  }
  .scd-butterfly-wing {
    transform-box:view-box;
    transform-origin:center;
    transform:scaleX(.87);
    will-change:transform;
  }
  .scd-butterfly.is-flapping .scd-butterfly-wing {
    animation:scd-wingbeat var(--wing-period,.085s) ease-in-out infinite;
  }
  @keyframes scd-wingbeat {
    0%,100% {transform:scaleX(.23)}
    50% {transform:scaleX(1)}
  }
  @media(prefers-reduced-motion:reduce) {
    .scd-butterfly-layer {display:none!important}
    .scd-butterfly-wing {animation:none!important}
  }
</style>

<script>
(() => {
  const layer=document.querySelector('[data-scd-butterfly-layer]');
  const hero=document.querySelector('.hero');
  const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
  if(!layer)return;

  // Pieris rapae wingbeat: Jantzen & Eisner 2008, PMC2575472, 11.8 Hz.
  // Papilio xuthus wingbeat: Kitamura & Imafuku 2015,
  // PMC4590450, ~10.4–10.8 Hz (depending on sex).
  // Flight paths and silhouettes are artistic approximations, not motion capture.
  const TAU=Math.PI*2;
  const random=(a,b)=>a+Math.random()*(b-a);
  const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
  const specs={
    pieris: {
      size:[48,60],frequency:11.8,interval:[21000,48000],
      flight:[17500,25500],bob:3.3,swoop:11,
      x:[-.12,.11,.31,.22,.48,.70,.58,.83,1.11],
      y:[.49,.68,.26,.57,.80,.24,.65,.76,.37],
      flap:[720,1500],pause:[65,190]
    },
    papilio: {
      size:[78,99],frequency:10.6,interval:[100000,190000],
      flight:[19000,28500],bob:2.2,swoop:7,
      x:[-.13,.13,.30,.48,.40,.65,.84,1.13],
      y:[.56,.34,.63,.24,.50,.70,.35,.43],
      flap:[1050,1900],pause:[90,260]
    }
  };
  function catmull(a,b,c,d,t) {
    const t2=t*t,t3=t2*t;
    return {
      x:.5*(2*b.x+(-a.x+c.x)*t+(2*a.x-5*b.x+4*c.x-d.x)*t2+(-a.x+3*b.x-3*c.x+d.x)*t3),
      y:.5*(2*b.y+(-a.y+c.y)*t+(2*a.y-5*b.y+4*c.y-d.y)*t2+(-a.y+3*b.y-3*c.y+d.y)*t3)
    };
  }
  function sample(points,u) {
    const last=points.length-1;
    const step=clamp(u,0,1)*last;
    const i=Math.min(last-1,Math.floor(step));
    return catmull(points[Math.max(0,i-1)],points[i],points[i+1],points[Math.min(last,i+2)],step-i);
  }

  // Two Pieris slots run independently; the Papilio slot is much rarer.
  const butterflies=[...layer.querySelectorAll('[data-scd-butterfly]')].map((el,index)=>{
    const species=el.dataset.scdButterfly;
    const spec=specs[species];
    const state={index,species,spec,el,timer:0,wingTimer:0,frame:0,active:false};

    function schedule(first=false) {
      clearTimeout(state.timer);
      if(reducedMotion.matches)return;
      const delay=first
        ? species==='pieris'
          ? index===0?random(7000,21000):random(24000,45000)
          : random(90000,165000)
        : random(...spec.interval);
      state.timer=window.setTimeout(start,delay);
    }

    function wingCycle(flapping) {
      if(!state.active)return;
      el.classList.toggle('is-flapping',flapping);
      clearTimeout(state.wingTimer);
      state.wingTimer=window.setTimeout(
        ()=>wingCycle(!flapping),
        flapping?random(...spec.flap):random(...spec.pause)
      );
    }

    function stop() {
      state.active=false;
      cancelAnimationFrame(state.frame);
      clearTimeout(state.wingTimer);
      state.frame=0;
      el.style.display='none';
      el.classList.remove('is-flapping');
      schedule();
    }

    function start() {
      if(state.active||reducedMotion.matches||document.hidden){schedule();return}
      const width=innerWidth,height=innerHeight;
      const heroBottom=hero?.getBoundingClientRect().bottom??-100;
      const minY=clamp(heroBottom+34,40,height-105);
      const maxY=height-(species==='papilio'?95:65);
      if(maxY-minY<115){schedule();return}

      const reverse=Math.random()<.5;
      const points=spec.x.map((u,i)=>({
        x:(reverse?1-u:u)*width+(i===0||i===spec.x.length-1?0:random(-.045,.045)*width),
        y:minY+clamp(spec.y[i]+random(-.095,.095),.08,.92)*(maxY-minY)
      }));
      const duration=random(...spec.flight);
      const started=performance.now();
      const phase=random(0,TAU);
      const wingPhase=random(0,TAU);
      const size=random(...spec.size);
      const ratio=species==='papilio'?116/150:85/120;
      el.style.width=size.toFixed(2)+'px';
      el.style.height=(size*ratio).toFixed(2)+'px';
      el.style.setProperty('--wing-period',(1/spec.frequency).toFixed(4)+'s');
      el.style.display='block';
      state.active=true;
      wingCycle(true);
      let heading=reverse?-90:90;

      function draw(now) {
        if(document.hidden||reducedMotion.matches){stop();return}
        const t=(now-started)*.001;
        const u=clamp((now-started)/duration,0,1);
        const center=sample(points,u);
        const ahead=sample(points,Math.min(1,u+.0025));
        const behind=sample(points,Math.max(0,u-.0025));
        const fastBob=spec.bob*Math.sin(TAU*spec.frequency*t+wingPhase);
        const slowBob=spec.swoop*Math.sin(TAU*(species==='pieris'?.82:.59)*t+phase)
          +4*Math.sin(TAU*(species==='pieris'?1.5:1.05)*t+wingPhase);
        const x=center.x+7*Math.sin(TAU*(species==='pieris'?.52:.35)*t+phase);
        const y=clamp(center.y+slowBob+fastBob,minY,maxY);
        const dx=ahead.x-behind.x,dy=ahead.y-behind.y;
        if(Math.hypot(dx,dy)>1){
          const desired=Math.atan2(dy,dx)*180/Math.PI+90;
          const delta=((desired-heading+540)%360)-180;
          heading+=delta*(species==='pieris'?.085:.065);
        }
        const roll=(species==='pieris'?8:6)*Math.sin(TAU*(species==='pieris'?1.06:.83)*t+phase)
          +2*Math.sin(TAU*spec.frequency*t+wingPhase);
        const scale=1+.025*Math.sin(TAU*1.65*t+wingPhase);
        el.style.transform='translate3d('+x.toFixed(2)+'px,'+y.toFixed(2)+'px,0) rotate('+
          (heading+roll).toFixed(2)+'deg) scale('+scale.toFixed(3)+')';
        const blackBoundary=hero?.getBoundingClientRect().bottom??-100;
        el.style.visibility=y<blackBoundary+24?'hidden':'visible';
        if(u<1)state.frame=requestAnimationFrame(draw);
        else stop();
      }
      state.frame=requestAnimationFrame(draw);
    }

    state.schedule=schedule;
    state.stop=stop;
    return state;
  });

  butterflies.forEach(b=>b.schedule(true));
  document.addEventListener('visibilitychange',()=>{
    if(document.hidden)butterflies.forEach(b=>{if(b.active)b.stop()});
  });
  reducedMotion.addEventListener('change',()=>{
    if(reducedMotion.matches){
      butterflies.forEach(b=>{
        clearTimeout(b.timer);
        if(b.active)b.stop();
        clearTimeout(b.timer);
      });
    }else butterflies.forEach(b=>{if(!b.active)b.schedule(true)});
  });
})();
</script>
