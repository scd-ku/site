---
/**
 * Ground and wall visitors.
 * Chicken is a simplified standing hen in side view; its left/right legs
 * alternate during walking. Japanese tree frog (Dryophytes japonicus)
 * is shown from above, with four splayed limbs and rounded adhesive pads.
 * Silhouettes are original approximations rather than traced copyrighted
 * photographs. Photo color appears only inside the pointer aperture.
 *
 * Image credits:
 * Hen "Mille Fleur d'Uccle Bantam Hen running.jpg" by Simplybrittney,
 * Wikimedia Commons, CC0.
 * Frog "Japanese tree frog (Hyla japonica), green.jpg" by Warehadokuro,
 * Wikimedia Commons, CC BY-SA 4.0 (masked/cropped in silhouette).
 *
 * References on frog attachment/climbing:
 * https://pmc.ncbi.nlm.nih.gov/articles/PMC6107968/
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL+'/';
const chickenFile = "Mille Fleur d'Uccle Bantam Hen running.jpg";
const frogFile = 'Japanese tree frog (Hyla japonica), green.jpg';
const commons=(name)=>'https://commons.wikimedia.org/wiki/Special:FilePath/'+encodeURIComponent(name)+'?width=640';
const photos={
  chicken:existsSync(join(process.cwd(),'public/fauna/chicken.jpg'))?base+'fauna/chicken.jpg':commons(chickenFile),
  frog:existsSync(join(process.cwd(),'public/fauna/japanese-tree-frog.jpg'))?base+'fauna/japanese-tree-frog.jpg':commons(frogFile)
};
const bodies={
  chicken:{
    w:240,h:160,
    // Full tail, compact torso, upright neck, beak and modest hen's comb.
    body:'M34 84 Q19 70 11 46 Q32 54 48 62 Q26 47 24 28 Q53 42 66 64 Q54 37 56 17 Q76 39 80 69 C104 56 141 59 154 64 Q170 58 177 45 Q182 37 183 29 L178 25 L184 17 L192 23 L198 13 L205 22 L210 18 L210 29 Q219 29 221 38 L232 42 L220 48 L211 47 Q206 58 201 64 C189 84 199 100 187 112 Q174 130 151 131 Q112 140 78 122 C52 114 47 101 34 84 Z',
    wattle:'M205 50 Q211 58 208 67 Q199 71 198 58 Z',
    legBack:'M113 120 Q118 137 113 148 L98 154 Q96 157 106 157 L118 155 L130 157 Q134 158 132 153 L122 149 L124 124 Z',
    legFront:'M156 121 Q162 136 157 149 L142 153 Q137 157 146 157 L158 155 L171 157 Q177 157 173 153 L164 148 L168 119 Z',
    eye:[207,37,2.2]
  },
  frog:{
    w:160,h:176,
    // Dorsal Japanese tree frog, hindlimbs longer than forelimbs and distinct
    // toe pads at the ends of four grasping limbs.
    body:'M80 33 Q57 25 47 44 Q35 59 42 82 Q43 107 59 137 Q68 152 81 151 Q92 147 103 126 Q117 100 119 76 Q125 55 109 40 Q97 27 80 33 Z',
    head:'M46 57 Q44 37 53 30 Q60 23 71 29 Q81 25 91 29 Q101 22 110 33 Q121 44 116 58 Q105 63 96 57 Q80 54 63 57 Q55 63 46 57 Z',
    arms:[
      'M52 72 Q32 64 23 48 L11 34 Q7 31 4 36 Q3 42 9 44 L15 51 L7 62 Q3 67 9 69 Q14 71 18 65 L26 57 Q32 73 50 84 Z',
      'M108 72 Q128 64 137 48 L149 34 Q153 31 156 36 Q157 42 151 44 L145 51 L153 62 Q157 67 151 69 Q146 71 142 65 L134 57 Q128 73 110 84 Z',
      'M60 123 Q40 132 31 146 L17 156 Q12 158 13 165 Q16 170 22 166 L33 158 L28 172 Q29 178 36 174 L46 160 Q52 148 68 142 Z',
      'M100 123 Q120 132 129 146 L143 156 Q148 158 147 165 Q144 170 138 166 L127 158 L132 172 Q131 178 124 174 L114 160 Q108 148 92 142 Z'
    ],
    eyeL:[56,41,6.5],eyeR:[103,41,6.5]
  }
};
function svg(kind,photo){
  const f=bodies[kind];
  const pid='fauna-pattern-'+kind+(photo?'-color':'-black');
  const pattern=photo?'<defs><pattern id="'+pid+'" patternUnits="userSpaceOnUse" width="'+f.w+'" height="'+f.h+'"><image href="'+photos[kind]+'" x="0" y="0" width="'+f.w+'" height="'+f.h+'" preserveAspectRatio="xMidYMid slice"/></pattern></defs>':'';
  const fill=photo?'url(#'+pid+')':'currentColor';
  const shape=(d,cls='')=>'<path'+(cls?' class="'+cls+'"':'')+' d="'+d+'" fill="'+fill+'"/>';
  if(kind==='chicken'){
    const back=shape(f.legBack,'fauna-leg fauna-leg--back');
    const front=shape(f.legFront,'fauna-leg fauna-leg--front');
    return '<svg viewBox="0 0 240 160" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">'+pattern+
      back+front+shape(f.body,'fauna-chicken-body')+shape(f.wattle)+
      (!photo?'<circle cx="'+f.eye[0]+'" cy="'+f.eye[1]+'" r="'+f.eye[2]+'" fill="#fff"/>':'')+'</svg>';
  }
  const limbs=f.arms.map((d,i)=>shape(d,'fauna-frog-limb fauna-frog-limb--'+i)).join('');
  const eyes=photo?'':('<circle cx="'+f.eyeL[0]+'" cy="'+f.eyeL[1]+'" r="'+f.eyeL[2]+'" fill="currentColor"/>'+
    '<circle cx="'+f.eyeR[0]+'" cy="'+f.eyeR[1]+'" r="'+f.eyeR[2]+'" fill="currentColor"/>');
  return '<svg viewBox="0 0 160 176" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">'+
    pattern+limbs+shape(f.body)+shape(f.head)+eyes+'</svg>';
}
---
<div class="scd-fauna-layer" data-scd-fauna-layer aria-hidden="true">
  <div class="scd-fauna scd-fauna--chicken" data-fauna="chicken" set:html={svg('chicken',false)}></div>
  <div class="scd-fauna scd-fauna--frog" data-fauna="frog" set:html={svg('frog',false)}></div>
</div>
<div class="scd-fauna-photo-layer" data-scd-fauna-photo-layer aria-hidden="true">
  <div class="scd-fauna scd-fauna--chicken" data-fauna-photo="chicken" set:html={svg('chicken',true)}></div>
  <div class="scd-fauna scd-fauna--frog" data-fauna-photo="frog" set:html={svg('frog',true)}></div>
</div>

<style>
  .scd-fauna-layer {
    position:fixed;left:0;top:0;width:100%;height:0;
    z-index:79;pointer-events:none;overflow:visible;
  }
  .scd-fauna-photo-layer {
    position:fixed;inset:0;overflow:hidden;pointer-events:none;
    z-index:1004;visibility:hidden;
  }
  .scd-fauna {
    display:none;position:absolute;left:0;top:0;
    color:#111;pointer-events:none;
    transform-origin:center center;will-change:transform;
  }
  .scd-fauna--chicken {width:126px;height:84px}
  .scd-fauna--frog {width:63px;height:69px}
  :global(.scd-fauna svg){display:block;width:100%;height:100%;overflow:visible}
  :global(.fauna-leg){transform-box:view-box;will-change:transform}
  :global(.fauna-leg--back){transform-origin:119px 120px}
  :global(.fauna-leg--front){transform-origin:160px 120px}
  .scd-fauna.is-walking :global(.fauna-leg--back){animation:fauna-back-step .72s ease-in-out infinite}
  .scd-fauna.is-walking :global(.fauna-leg--front){animation:fauna-front-step .72s ease-in-out infinite}
  @keyframes fauna-back-step {0%,100%{transform:rotate(-15deg)}50%{transform:rotate(18deg)}}
  @keyframes fauna-front-step {0%,100%{transform:rotate(18deg)}50%{transform:rotate(-15deg)}}
  :global(.fauna-frog-limb){transform-box:view-box;transform-origin:80px 97px;will-change:transform}
  .scd-fauna.is-crawling :global(.fauna-frog-limb--0),
  .scd-fauna.is-crawling :global(.fauna-frog-limb--3){animation:fauna-frog-gait .84s ease-in-out infinite}
  .scd-fauna.is-crawling :global(.fauna-frog-limb--1),
  .scd-fauna.is-crawling :global(.fauna-frog-limb--2){animation:fauna-frog-gait .84s ease-in-out infinite reverse}
  @keyframes fauna-frog-gait{0%,100%{transform:rotate(-9deg)}50%{transform:rotate(10deg)}}
  .scd-fauna-photo-layer :global(.fauna-leg),
  .scd-fauna-photo-layer :global(.fauna-frog-limb){animation:none!important}
  @media(prefers-reduced-motion:reduce){
    .scd-fauna-layer,.scd-fauna-photo-layer{display:none!important}
  }
</style>

<script>
(() => {
  const layer=document.querySelector('[data-scd-fauna-layer]');
  const photoLayer=document.querySelector('[data-scd-fauna-photo-layer]');
  const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
  if(!layer||!photoLayer||reduced.matches)return;
  const footer=document.querySelector('main#top > footer');
  const hero=document.querySelector('.hero');
  const xMax=()=>Math.max(300,document.documentElement.clientWidth);
  const docY=(el,position)=>el?el.getBoundingClientRect()[position]+scrollY:0;
  const clamp=(v,a,b)=>Math.min(b,Math.max(a,v));
  const rnd=(a,b)=>a+Math.random()*(b-a);
  const states=['chicken','frog'].map(kind=>{
    const el=layer.querySelector('[data-fauna="'+kind+'"]');
    const photo=photoLayer.querySelector('[data-fauna-photo="'+kind+'"]');
    const width=kind==='chicken'?126:63;
    const height=kind==='chicken'?84:69;
    el.style.display='block';photo.style.display='block';
    return {kind,el,photo,width,height,x:0,y:0,direction:1,heading:0,
      speed:kind==='chicken'?rnd(20,31):rnd(10,18),
      phase:rnd(0,6.28),pauseUntil:0,targetX:0,targetY:0,scale:1};
  });
  const chicken=states[0],frog=states[1];
  const ground=()=>docY(footer,'top')-7;
  const frogTop=()=>Math.max(40,docY(hero,'bottom')+25);
  const frogBottom=()=>Math.max(frogTop()+80,docY(footer,'top')-frog.height-20);
  chicken.x=rnd(90,Math.max(100,xMax()-200));
  frog.x=rnd(70,Math.max(75,xMax()-130));
  frog.y=clamp(scrollY+innerHeight*.5,frogTop(),frogBottom());
  const chooseFrogTarget=()=>{
    const rangeY=frogBottom()-frogTop();
    frog.targetX=clamp(frog.x+rnd(-280,280),20,xMax()-frog.width-20);
    frog.targetY=clamp(frog.y+rnd(-Math.min(rangeY*.28,520),Math.min(rangeY*.28,520)),frogTop(),frogBottom());
    if(Math.hypot(frog.targetX-frog.x,frog.targetY-frog.y)<60){
      frog.targetY=clamp(frog.y+(Math.random()<.5?-110:110),frogTop(),frogBottom());
    }
  };
  chooseFrogTarget();

  let pointerX=innerWidth/2,pointerY=innerHeight/2,seenPointer=false;
  addEventListener('pointermove',(e)=>{pointerX=e.clientX;pointerY=e.clientY;seenPointer=true},{passive:true});
  let frame=0,prev=0;
  function draw(now) {
    if(document.hidden||reduced.matches){frame=0;return}
    const dt=prev?Math.min((now-prev)/1000,.055):0;
    prev=now;
    const groundY=ground();
    const maxX=xMax();

    // The feet always touch the top of the copyright footer, which acts as
    // a ground line. Turning at the edges doesn't change document Y.
    chicken.x+=chicken.direction*chicken.speed*dt;
    if(chicken.x>maxX-chicken.width-22){chicken.x=maxX-chicken.width-22;chicken.direction=-1}
    if(chicken.x<22){chicken.x=22;chicken.direction=1}
    const cycle=now/1000;
    chicken.y=groundY-chicken.height;
    const bob=Math.abs(Math.sin(cycle*8.73+chicken.phase))*1.2;
    chicken.heading=0;chicken.scale=1;
    chicken.el.classList.add('is-walking');
    chicken.el.style.transform='translate3d('+chicken.x+'px,'+(chicken.y-scrollY-bob)+'px,0) scaleX('+chicken.direction+')';

    // A frog climbs the visible document surface rather than a fixed
    // viewport. Adhesive pads imply intermittent gripping/resting; limbs
    // alternate in a slow crawl, interrupted by tiny forward hops.
    const dx=frog.targetX-frog.x,dy=frog.targetY-frog.y;
    const distance=Math.hypot(dx,dy);
    let crawling=false;
    if(now>=frog.pauseUntil){
      if(distance<8){
        frog.pauseUntil=now+rnd(700,3600);
        chooseFrogTarget();
      }else{
        const step=Math.min(distance,frog.speed*dt);
        frog.x+=(dx/distance)*step;
        frog.y+=(dy/distance)*step;
        // SVG head points upward. The angle aligns its head with movement.
        const targetAngle=Math.atan2(dy,dx)*180/Math.PI+90;
        frog.heading+=(((targetAngle-frog.heading+540)%360)-180)*Math.min(1,dt*4);
        crawling=true;
        if(Math.random()<dt*.11){
          frog.pauseUntil=now+rnd(400,1400);
        }
      }
    }
    frog.y=clamp(frog.y,frogTop(),frogBottom());
    frog.el.classList.toggle('is-crawling',crawling);
    const jitter=crawling?1.7*Math.sin(cycle*7.3+frog.phase):0;
    frog.el.style.transform='translate3d('+(frog.x+jitter)+'px,'+(frog.y-scrollY)+'px,0) rotate('+frog.heading+'deg)';
    for(const s of states) {
      const {el,photo,width,height,kind}=s;
      // Cursor-only photo reveal. The original black silhouette stays intact.
      const cx=s.x+width*.5,cy=s.y-scrollY+height*.5;
      s.photo.style.display=el.style.display;
      s.photo.style.width=width+'px';
      s.photo.style.height=height+'px';
      const parts=kind==='chicken'?'.fauna-leg':'.fauna-frog-limb';
      const liveParts=el.querySelectorAll(parts), photoParts=photo.querySelectorAll(parts);
      for(let i=0;i<Math.min(liveParts.length,photoParts.length);i++){
        photoParts[i].style.animation='none';
        photoParts[i].style.transform=getComputedStyle(liveParts[i]).transform;
      }
      s.screenX=cx;s.screenY=cy;
    }
    updateReveal();
    frame=requestAnimationFrame(draw);
  }

  function updateReveal(){
    if(!seenPointer){photoLayer.style.visibility='hidden';return}
    const style=getComputedStyle(document.documentElement);
    const mode=document.body.dataset.cursorStyle;
    const size=parseFloat(style.getPropertyValue('--cursor-size'))||60;
    const zoom=mode==='pulse'?(parseFloat(style.getPropertyValue('--cursor-zoom'))||1.5):1;
    const radius=mode==='line'?Math.max(14,Math.min(25,size*.4)):size*.5;
    const intersection=states.some(s=>Math.hypot(pointerX-s.screenX,pointerY-s.screenY)<radius+Math.max(s.width,s.height));
    photoLayer.style.visibility=intersection?'visible':'hidden';
    if(!intersection)return;
    photoLayer.style.clipPath='circle('+radius+'px at '+pointerX+'px '+pointerY+'px)';
    photoLayer.style.webkitClipPath=photoLayer.style.clipPath;
    for(const s of states){
      const p=s.photo;
      const x=pointerX+zoom*(s.x-pointerX);
      const y=pointerY+zoom*(s.y-scrollY-pointerY);
      p.style.width=s.width*zoom+'px';
      p.style.height=s.height*zoom+'px';
      if(s.kind==='chicken'){
        const bob=Math.abs(Math.sin(performance.now()/1000*8.73+s.phase))*1.2;
        p.style.transform='translate3d('+x+'px,'+(y-zoom*bob)+'px,0) scaleX('+s.direction+')';
      } else {
        p.style.transform='translate3d('+x+'px,'+y+'px,0) rotate('+s.heading+'deg)';
      }
    }
  }

  frame=requestAnimationFrame(draw);
  const resume=()=>{if(!document.hidden&&!reduced.matches&&!frame){prev=0;frame=requestAnimationFrame(draw)}};
  document.addEventListener('visibilitychange',resume);
  reduced.addEventListener('change',()=>{if(reduced.matches){
    cancelAnimationFrame(frame);frame=0;photoLayer.style.visibility='hidden';
    layer.style.display='none';
  }else{layer.style.display='block';resume();}});
})();
</script>
