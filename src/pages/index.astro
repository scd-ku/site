---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import AppGrid from '../components/AppGrid.astro';
import HeroScienceField from '../components/HeroScienceField.astro';
import apps from '../data/apps.generated.json';
---
<BaseLayout>
  <main id="top">
    <Header />

    <section class="hero">
      <HeroScienceField />
      <div class="hero-content">
        <p class="eyebrow">Kagawa University · Program in Media and Product Design</p>
        <h1><span>Science, Education,</span><br /><span>Design and Communication.</span></h1>
      </div>
      <a class="scroll-cue" href="#projects">Explore projects <span>↓</span></a>
      <div class="hero-index" aria-hidden="true">
        <span>SC / D</span><span>2026</span>
      </div>
    </section>

    <AppGrid apps={apps} />

    <section id="about" class="text-section about-section">
      <div class="section-kicker"><span>01</span><span>About</span></div>
      <div class="text-grid">
        <h2>Science becomes tangible through tools, expression and dialogue.</h2>
        <p>科学・教育・デザイン・コミュニケーションを横断し、科学技術や地域文化を素材に、初等中等教育やSTEAMへ接続する教材、Webアプリ、実験装置、インターフェース、表現手法を研究・開発しています。</p>
      </div>
    </section>

    <section id="people" class="text-section people-section">
      <div class="section-kicker"><span>02</span><span>People</span></div>
      <div class="people-grid">
        <div class="person-primary">
          <h2>Akihiro Osaki</h2>
          <p>Associate Professor<br />Kagawa University</p>
        </div>
        <div class="people-list">
          <div><span>Science Communication</span><span>Research / Practice</span></div>
          <div><span>Design &amp; Fabrication</span><span>Tools / Materials</span></div>
          <div><span>Students / Collaborators</span><span>Coming soon</span></div>
        </div>
      </div>
    </section>

    <footer>
      <span>Science Communication Design Laboratory, Kagawa University</span>
      <span>GitHub · scd-ku</span>
      <span><a href="./privacy/">Privacy / Analytics</a> · © 2026</span>
    </footer>
  </main>
</BaseLayout>
