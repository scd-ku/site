---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import AppGrid from '../components/AppGrid.astro';
import HeroScienceField from '../components/HeroScienceField.astro';
import apps from '../data/apps.generated.json';
import externalProjects from '../data/external-projects.generated.json';
---
<BaseLayout>
  <main id="top">
    <Header />

    <section class="hero">
      <HeroScienceField />
      <div class="hero-content">
        <p class="eyebrow">Kagawa University · Program in Media and Product Design</p>
        <h1 data-reactive-weight><span class="hero-weight-line">Science, Education, Engineering</span><br /><span class="hero-weight-line">Design &amp; Communication.</span></h1>
      </div>
      <a class="scroll-cue" href="#projects">Explore projects <span>↓</span></a>
      <div class="hero-index" aria-hidden="true">
        <span>SC / D</span><span>2026</span>
      </div>
    </section>

    <AppGrid apps={[...apps, ...externalProjects]} />

    <section id="about" class="text-section about-section">
      <div class="section-kicker"><span>About</span></div>

      <div class="about-block about-block--lab">
        <h2 class="about-lead">科学技術と社会をつなぎ、新しい学びや体験をデザインする</h2>
        <div class="about-prose">
          <p>科学コミュニケーションデザイン研究室は、2026年4月に立ち上がりました。</p>
          <p>先端科学技術や地域の産業・文化を素材に、専門家と学習者・市民を橋渡ししながら、主に初等中等教育の理科・STEAM教育へ接続する教材を研究します。</p>
          <p>3Dプリンタやレーザーカッターなどの先端加工技術、IoTデバイス設計、Webや生成AIを含む情報技術を活用し、これまでにない教材や手法を現場と連携して検証します。社会の中で使われ続ける学びの仕組みをつくり、工学的なものづくりの力で科学コミュニケーションを実践できる仲間を育てることを目指します。</p>
        </div>
      </div>

      <div class="about-block about-block--site">
        <p class="about-mini-label">About this site</p>
        <div class="about-prose">
          <p>このサイトでは、研究室で開発したツールや教材を公開しています。Webアプリの多くは生成AIを活用し、できるだけ1つのHTMLファイルで完結させ、利用者自身が授業や活動に合わせて改変できることも想定しています。</p>
          <p>教材では、効果だけでなく、その背後にある仕組みやモデルの理解を重視しています。信頼できる学術情報や既存ライブラリを参照し、可能な限り検証するとともに、出典や仕組みを記載しています。</p>
          <p>着想や工夫の来歴と適切な帰属を大切にし、学び、改変し、再び共有できるオープンなものづくりの場を目指します。</p>
          <p class="about-year-note">※印のプロジェクトは、大﨑がお茶の水女子大学に在籍していた時期に初版を開発し、その後も本研究室で継続して改変しているものです。</p>
        </div>
      </div>

    </section>

    <section id="people" class="text-section people-section">
      <div class="section-kicker"><span>People</span></div>
      <div class="people-grid people-grid--single">
        <div class="person-primary">
          <h2 class="person-name"><span class="person-name-jp">大﨑章弘</span><span class="person-name-sep"> / </span><span class="person-name-en">Akihiro Osaki</span></h2>
          <p>准教授 / Associate Professor</p>
          <a class="person-link" href="https://researchmap.jp/osaki" target="_blank" rel="noreferrer">researchmap.jp/osaki ↗</a>
        </div>
      </div>
    </section>

    <section id="contact" class="text-section contact-section">
      <div class="section-kicker"><span>Contact</span></div>
      <div class="contact-grid">
        <div class="contact-copy">
          <h2 class="contact-name-jp">科学コミュニケーションデザイン研究室</h2>
          <p class="contact-name-en">Science Communication Design Laboratory</p>
          <address>
            <p>〒760-8521<br />香川県高松市幸町 1-1<br />研究交流棟4F 403号室</p>
          </address>
          <dl class="contact-list">
            <div><dt>Tel</dt><dd><a data-contact-phone aria-label="電話番号"></a></dd></div>
            <div><dt>Email</dt><dd><a data-contact-email aria-label="メールアドレス"></a></dd></div>
          </dl>
          <noscript><p class="contact-noscript">電話番号・メールアドレスの表示にはJavaScriptを有効にしてください。</p></noscript>
        </div>
        <div class="contact-map" aria-label="香川大学 幸町キャンパス 研究交流棟の地図">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d857.8036472331239!2d134.03579716832738!3d34.34247160649481!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3553ebea56330f3d%3A0x1ef6801acfb5c4c7!2z44CSNzYwLTAwMTYg6aaZ5bed55yM6auY5p2-5biC5bm455S677yRIOeglOeptuS6pOa1geajnw!5e1!3m2!1sja!2sjp!4v1790520764449!5m2!1sja!2sjp" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="Science Communication Design Laboratory map"></iframe>
        </div>
      </div>
    </section>

    <footer>
      <span>© 2026 SCIENCE COMMUNICATION DESIGN LABORATORY, KAGAWA UNIVERSITY</span>
      <span><a href="./privacy/">Privacy / Analytics</a></span>
    </footer>
  </main>


<script is:inline>
(() => {
  const fromCodes = (codes) => String.fromCharCode(...codes);
  const phone = [48,56,55,45,56,51,50,45,49,55,51,54];
  const email = [111,115,97,107,105,46,97,107,105,104,105,114,111,64,107,97,103,97,119,97,45,117,46,97,99,46,106,112];
  const phoneText = fromCodes(phone);
  const emailText = fromCodes(email);
  document.querySelectorAll('[data-contact-phone]').forEach((el) => {
    el.textContent = phoneText;
    el.href = 'tel:' + phoneText;
  });
  document.querySelectorAll('[data-contact-email]').forEach((el) => {
    el.textContent = emailText;
    el.href = 'mailto:' + emailText;
  });
})();
</script>

<script is:inline>
(() => {
  const title = document.querySelector('[data-reactive-weight]');
  if (!title) return;

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lines = [...title.querySelectorAll('.hero-weight-line')];
  const chars = [];
  const BASE_HIGH = 390;
  const BASE_LOW = 285;
  const HOVER_BOOST = 115;
  const RADIUS = 150;
  const SIGMA = 66;

  const makeChar = (character, baseWeight) => {
    if (character === ' ') {
      const space = document.createTextNode(' ');
      return space;
    }
    const span = document.createElement('span');
    span.className = 'hero-weight-char';
    span.textContent = character;
    span.dataset.baseWeight = String(baseWeight);
    span._currentWeight = baseWeight;
    span.style.setProperty('--hero-char-weight', baseWeight.toFixed(1));
    chars.push(span);
    return span;
  };

  lines.forEach((line) => {
    const source = line.textContent || '';
    const words = source.split(/(\s+)/);
    line.textContent = '';

    words.forEach((token) => {
      if (/^\s+$/.test(token)) {
        line.appendChild(document.createTextNode(token));
        return;
      }

      const word = document.createElement('span');
      word.className = 'hero-weight-word';
      const visibleChars = [...token];
      const denominator = Math.max(1, visibleChars.length - 1);

      visibleChars.forEach((character, index) => {
        const t = index / denominator;
        // A restrained word-level weight slope: slightly stronger at the start,
        // gradually lighter toward the end.
        const baseWeight = BASE_HIGH + (BASE_LOW - BASE_HIGH) * t;
        word.appendChild(makeChar(character, baseWeight));
      });
      line.appendChild(word);
    });
  });

  let pointer = { x: -9999, y: -9999, active: false };
  let raf = 0;

  const targetWeightFor = (char) => {
    const base = Number(char.dataset.baseWeight || 300);
    if (!pointer.active || reducedMotion) return base;

    const rect = char.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const dx = pointer.x - cx;
    const dy = (pointer.y - cy) * 1.25;
    const distance = Math.hypot(dx, dy);

    if (distance >= RADIUS) return base;

    // Gaussian-like pressure field: local, soft and visually stable.
    const influence = Math.exp(-(distance * distance) / (2 * SIGMA * SIGMA));
    return Math.min(540, base + HOVER_BOOST * influence);
  };

  const animate = () => {
    let needsAnotherFrame = false;

    chars.forEach((char) => {
      const target = targetWeightFor(char);
      const current = Number.isFinite(char._currentWeight) ? char._currentWeight : target;
      const next = current + (target - current) * 0.18;
      char._currentWeight = next;
      char.style.setProperty('--hero-char-weight', next.toFixed(1));

      if (Math.abs(target - next) > 0.35) needsAnotherFrame = true;
    });

    raf = needsAnotherFrame || pointer.active
      ? requestAnimationFrame(animate)
      : 0;
  };

  const ensureAnimation = () => {
    if (!raf) raf = requestAnimationFrame(animate);
  };

  const updatePointer = (x, y) => {
    pointer.x = x;
    pointer.y = y;
    pointer.active = true;
    ensureAnimation();
  };

  window.addEventListener('pointermove', (event) => {
    updatePointer(event.clientX, event.clientY);
  }, { passive: true });

  window.addEventListener('pointerdown', (event) => {
    updatePointer(event.clientX, event.clientY);
  }, { passive: true });

  window.addEventListener('pointerleave', () => {
    pointer.active = false;
    ensureAnimation();
  }, { passive: true });

  window.addEventListener('blur', () => {
    pointer.active = false;
    ensureAnimation();
  });

  // Touch devices: finger position drives the same local weight field.
  window.addEventListener('touchstart', (event) => {
    const touch = event.touches[0];
    if (touch) updatePointer(touch.clientX, touch.clientY);
  }, { passive: true });

  window.addEventListener('touchmove', (event) => {
    const touch = event.touches[0];
    if (touch) updatePointer(touch.clientX, touch.clientY);
  }, { passive: true });

  window.addEventListener('touchend', () => {
    pointer.active = false;
    ensureAnimation();
  }, { passive: true });
})();
</script>

</BaseLayout>
