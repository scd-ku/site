---
import '../styles/global.css';
import PrivacyAnalytics from '../components/PrivacyAnalytics.astro';
const {
  title = 'Science Communication Design Laboratory',
  description = 'Science Communication Design Laboratory, Kagawa University — public web applications and projects.'
} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg?v=27`} />
    <link rel="alternate icon" type="image/png" href={`${base}favicon.png?v=27`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png?v=27`} />
    <link rel="manifest" href={`${base}site.webmanifest?v=27`} />
    <title>{title}</title>
  </head>
  <body>
    <canvas class="cursor-trail" aria-hidden="true"></canvas>
    <div class="blind-overlay" aria-hidden="true"></div>
    <div class="blind-window-ring" aria-hidden="true"></div>
    <div class="cursor-invert-lens" aria-hidden="true"></div>
    <div class="cursor-magnifier-lens" aria-hidden="true"><div class="cursor-magnifier-scene"></div></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <slot />
    <PrivacyAnalytics />

    <script is:inline>
      (() => {
      const dot = document.querySelector('.cursor-dot');
      const invertLens = document.querySelector('.cursor-invert-lens');
      const trailCanvas = document.querySelector('.cursor-trail');
      const blindRing = document.querySelector('.blind-window-ring');
      const magnifierLens = document.querySelector('.cursor-magnifier-lens');
      const magnifierScene = document.querySelector('.cursor-magnifier-scene');
      const trailCtx = trailCanvas?.getContext('2d');
      const root = document.documentElement;
      const body = document.body;
      const clampValue = (n, min, max) => Math.max(min, Math.min(max, n));
      const cursorDefaults = { style: 'stripe', motion: 54, size: 48, zoom: 1.5, lineHue: 210, invertHue: 0, trail: 42 };
      const cursorState = { ...cursorDefaults };
      let pathPoints = [];
      let pointerX = innerWidth / 2;
      let pointerY = innerHeight / 2;
      let deviceScale = Math.max(1, Math.min(2, devicePixelRatio || 1));

      function syncTrailViewport(){
        if (!trailCanvas || !trailCtx) return;
        deviceScale = Math.max(1, Math.min(2, devicePixelRatio || 1));
        trailCanvas.width = Math.round(innerWidth * deviceScale);
        trailCanvas.height = Math.round(innerHeight * deviceScale);
        trailCanvas.style.width = `${innerWidth}px`;
        trailCanvas.style.height = `${innerHeight}px`;
        trailCtx.setTransform(deviceScale,0,0,deviceScale,0,0);
      }
      syncTrailViewport();
      addEventListener('resize', () => {
        syncTrailViewport();
        rebuildMagnifier();
      }, { passive:true });

      let magnifierSource = null;
      let magnifierClone = null;
      let magnifierFixedPairs = [];

      function stripCloneIds(node){
        if (!(node instanceof Element)) return;
        node.removeAttribute('id');
        node.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
      }

      function copyInteractiveState(sourceRoot, cloneRoot){
        if (!sourceRoot || !cloneRoot) return;

        const sourceInputs = sourceRoot.matches?.('input,select,textarea') ? [sourceRoot] : [...sourceRoot.querySelectorAll('input,select,textarea')];
        const cloneInputs = cloneRoot.matches?.('input,select,textarea') ? [cloneRoot] : [...cloneRoot.querySelectorAll('input,select,textarea')];
        for (let i=0;i<Math.min(sourceInputs.length,cloneInputs.length);i++){
          const src=sourceInputs[i], dst=cloneInputs[i];
          if ('value' in src && 'value' in dst) dst.value=src.value;
          if ('checked' in src && 'checked' in dst) dst.checked=src.checked;
          if ('selectedIndex' in src && 'selectedIndex' in dst) dst.selectedIndex=src.selectedIndex;
        }

        const sourceOutputs = sourceRoot.matches?.('output') ? [sourceRoot] : [...sourceRoot.querySelectorAll('output')];
        const cloneOutputs = cloneRoot.matches?.('output') ? [cloneRoot] : [...cloneRoot.querySelectorAll('output')];
        for (let i=0;i<Math.min(sourceOutputs.length,cloneOutputs.length);i++) cloneOutputs[i].textContent=sourceOutputs[i].textContent;

        const sourceButtons = sourceRoot.matches?.('button') ? [sourceRoot] : [...sourceRoot.querySelectorAll('button')];
        const cloneButtons = cloneRoot.matches?.('button') ? [cloneRoot] : [...cloneRoot.querySelectorAll('button')];
        for (let i=0;i<Math.min(sourceButtons.length,cloneButtons.length);i++){
          cloneButtons[i].className=sourceButtons[i].className;
          ['aria-expanded','aria-pressed','disabled'].forEach((name)=>{
            const value=sourceButtons[i].getAttribute(name);
            if(value===null) cloneButtons[i].removeAttribute(name); else cloneButtons[i].setAttribute(name,value);
          });
        }

        const sourceLabels = [...sourceRoot.querySelectorAll('[data-screen-label],[data-cursor-slider1-label],[data-cursor-slider2-label]')];
        const cloneLabels = [...cloneRoot.querySelectorAll('[data-screen-label],[data-cursor-slider1-label],[data-cursor-slider2-label]')];
        for (let i=0;i<Math.min(sourceLabels.length,cloneLabels.length);i++) cloneLabels[i].textContent=sourceLabels[i].textContent;
      }

      function addFixedMirror(sourceEl, cloneRoot){
        if (!(sourceEl instanceof Element) || !magnifierScene) return;
        const fixedClone=sourceEl.cloneNode(true);
        stripCloneIds(fixedClone);
        fixedClone.classList.add('magnifier-fixed-copy');
        fixedClone.removeAttribute('hidden');
        fixedClone.setAttribute('aria-hidden','true');
        if ('inert' in fixedClone) fixedClone.inert=true;
        magnifierScene.appendChild(fixedClone);
        magnifierFixedPairs.push({ source:sourceEl, clone:fixedClone });
        copyInteractiveState(sourceEl,fixedClone);
      }

      function rebuildMagnifier(){
        if (!magnifierScene) return;
        const source = document.querySelector('main#top');
        if (!source) return;
        const clone = source.cloneNode(true);
        stripCloneIds(clone);
        clone.setAttribute('aria-hidden','true');
        clone.classList.add('magnifier-document-copy');
        if ('inert' in clone) clone.inert = true;
        clone.querySelectorAll('iframe').forEach((frame) => {
          frame.setAttribute('tabindex','-1');
          frame.setAttribute('aria-hidden','true');
        });

        // Fixed-position UI is mirrored separately in document coordinates.
        clone.querySelectorAll('.site-header,.display-settings-popover').forEach((el)=>el.remove());

        magnifierScene.replaceChildren(clone);
        magnifierSource = source;
        magnifierClone = clone;
        magnifierFixedPairs = [];
        magnifierScene.style.width = `${document.documentElement.clientWidth}px`;

        const sourceHeader=source.querySelector('.site-header');
        if(sourceHeader) addFixedMirror(sourceHeader,clone);
        const sourcePopover=source.querySelector('.display-settings-popover');
        if(sourcePopover && !sourcePopover.hasAttribute('hidden')) addFixedMirror(sourcePopover,clone);

        copyInteractiveState(source,clone);
      }

      function syncMagnifierCanvases(){
        if (!magnifierSource || !magnifierClone) return;
        const sourceCanvases = magnifierSource.querySelectorAll('canvas');
        const cloneCanvases = magnifierClone.querySelectorAll('canvas');
        const count = Math.min(sourceCanvases.length, cloneCanvases.length);
        for (let i=0;i<count;i++){
          const src = sourceCanvases[i], dst = cloneCanvases[i];
          try {
            if (!src.width || !src.height) continue;
            if (dst.width !== src.width) dst.width = src.width;
            if (dst.height !== src.height) dst.height = src.height;
            const ctx = dst.getContext('2d');
            if (ctx) {
              ctx.setTransform(1,0,0,1,0,0);
              ctx.clearRect(0,0,dst.width,dst.height);
              ctx.drawImage(src,0,0);
            }
          } catch {}
        }
      }

      function syncMagnifierDynamicState(){
        if (!magnifierSource || !magnifierClone) return;
        copyInteractiveState(magnifierSource,magnifierClone);

        // Keep filtered cards, active buttons and generated inline styles current.
        const selectors=['.app-card','.hero-weight-char','.like-button'];
        selectors.forEach((selector)=>{
          const src=[...magnifierSource.querySelectorAll(selector)];
          const dst=[...magnifierClone.querySelectorAll(selector)];
          for(let i=0;i<Math.min(src.length,dst.length);i++){
            if(selector!=='.hero-weight-char') dst[i].className=src[i].className;
            if(src[i].hasAttribute('hidden')) dst[i].setAttribute('hidden',''); else dst[i].removeAttribute('hidden');
            if(selector==='.hero-weight-char') dst[i].style.cssText=src[i].style.cssText;
          }
        });

        // Mirror the project card currently under the real pointer, including its description panel.
        magnifierClone.querySelectorAll('.is-magnifier-hover').forEach((el)=>el.classList.remove('is-magnifier-hover'));
        const underneath=document.elementFromPoint(pointerX,pointerY);
        const hoveredCard=underneath?.closest?.('.app-card');
        if(hoveredCard?.dataset?.slug){
          magnifierClone.querySelector(`.app-card[data-slug="${CSS.escape(hoveredCard.dataset.slug)}"]`)?.classList.add('is-magnifier-hover');
        }

        // Fixed UI (header/settings) follows the exact current viewport position.
        const livePopover=magnifierSource.querySelector('.display-settings-popover');
        const hasPopoverPair=magnifierFixedPairs.some((pair)=>pair.source===livePopover);
        if(livePopover && !livePopover.hasAttribute('hidden') && !hasPopoverPair){
          addFixedMirror(livePopover,magnifierClone);
        }
        if(livePopover?.hasAttribute('hidden') && hasPopoverPair){
          const pair=magnifierFixedPairs.find((item)=>item.source===livePopover);
          pair?.clone.remove();
          magnifierFixedPairs=magnifierFixedPairs.filter((item)=>item!==pair);
        }

        magnifierFixedPairs.forEach((pair)=>{
          const rect=pair.source.getBoundingClientRect();
          pair.clone.style.position='absolute';
          pair.clone.style.left=`${window.scrollX+rect.left}px`;
          pair.clone.style.top=`${window.scrollY+rect.top}px`;
          pair.clone.style.width=`${rect.width}px`;
          pair.clone.style.height=`${rect.height}px`;
          pair.clone.style.margin='0';
          pair.clone.style.transform='none';
          pair.clone.style.display=getComputedStyle(pair.source).display;
          copyInteractiveState(pair.source,pair.clone);
        });

        // Match the moving hero geometry rather than running a second independent animation.
        const animatedSelectors=['.science-object','.science-object svg','.optics-canvas','.hero-weight-char'];
        animatedSelectors.forEach((selector)=>{
          const src=[...magnifierSource.querySelectorAll(selector)];
          const dst=[...magnifierClone.querySelectorAll(selector)];
          for(let i=0;i<Math.min(src.length,dst.length);i++){
            const cs=getComputedStyle(src[i]);
            dst[i].style.transform=cs.transform==='none'?'':cs.transform;
            dst[i].style.opacity=cs.opacity;
            dst[i].style.filter=cs.filter==='none'?'':cs.filter;
          }
        });
      }

      function updateMagnifier(){
        if (!magnifierLens || !magnifierScene) return;
        const active = cursorState.style === 'pulse' && root.dataset.sitePalette !== 'blind';
        if (!active) {
          magnifierLens.style.display='none';
          return;
        }
        if (!magnifierClone) rebuildMagnifier();
        const diameter = clampValue(cursorState.size,20,330);
        const radius = diameter/2;
        const zoom = clampValue(Number(cursorState.zoom) || 1.5,.1,10);
        magnifierLens.style.display='block';
        magnifierLens.style.width=`${diameter}px`;
        magnifierLens.style.height=`${diameter}px`;
        magnifierLens.style.transform=`translate3d(${pointerX-radius}px,${pointerY-radius}px,0)`;
        const docX = window.scrollX + pointerX;
        const docY = window.scrollY + pointerY;

        syncMagnifierDynamicState();
        syncMagnifierCanvases();

        // The pixel directly below the pointer remains at the centre of the lens.
        magnifierScene.style.transform = `translate3d(${radius-docX*zoom}px,${radius-docY*zoom}px,0) scale(${zoom})`;
      }

      const requestMagnifierRefresh=()=>{
        if(cursorState.style!=='pulse' || root.dataset.sitePalette==='blind') return;
        rebuildMagnifier();
      };
      document.addEventListener('input',()=>requestAnimationFrame(requestMagnifierRefresh),true);
      document.addEventListener('change',()=>requestAnimationFrame(requestMagnifierRefresh),true);
      document.addEventListener('click',()=>requestAnimationFrame(requestMagnifierRefresh),true);
      document.addEventListener('scd:cursor-state-applied',()=>requestAnimationFrame(requestMagnifierRefresh));
      function resampleTrail(points, spacing=5){
        if(points.length < 2) return points.slice();
        const out=[{...points[0]}];
        for(let i=1;i<points.length;i++){
          const a=points[i-1], b=points[i];
          const dx=b.x-a.x, dy=b.y-a.y;
          const dist=Math.hypot(dx,dy);
          if(dist < .001) continue;
          const steps=Math.max(1, Math.ceil(dist/spacing));
          for(let s=1;s<=steps;s++){
            const u=s/steps;
            out.push({x:a.x+dx*u, y:a.y+dy*u, t:a.t+(b.t-a.t)*u});
          }
        }
        return out;
      }

      function drawRibbon(now = performance.now()){
        if (!trailCtx || !trailCanvas) return;
        trailCtx.clearRect(0,0,innerWidth,innerHeight);
        if (cursorState.style !== 'line') return;

        const lifetime = 160 + (cursorState.trail / 100) * 2900;
        pathPoints = pathPoints.filter(p => now - p.t <= lifetime);
        if (pathPoints.length < 2) return;

        // Fixed-distance resampling prevents a fast pointer move from creating
        // one huge polygon that appears to stretch backward along the old trail.
        let sampled=resampleTrail(pathPoints, 5.5);
        if(sampled.length > 420) sampled=sampled.slice(sampled.length-420);
        if(sampled.length < 3) return;

        // A gentle 3-point filter smooths corners without overshooting the path.
        sampled=sampled.map((p,i,arr)=>{
          const a=arr[Math.max(0,i-1)], b=p, c=arr[Math.min(arr.length-1,i+1)];
          return {x:(a.x+b.x*2+c.x)/4, y:(a.y+b.y*2+c.y)/4, t:b.t};
        });

        const left=[], right=[];
        const maxWidth=12.5;
        for(let i=0;i<sampled.length;i++){
          const prev=sampled[Math.max(0,i-1)];
          const next=sampled[Math.min(sampled.length-1,i+1)];
          let dx=next.x-prev.x, dy=next.y-prev.y;
          const len=Math.hypot(dx,dy)||1;
          dx/=len; dy/=len;
          const nx=-dy, ny=dx;
          const u=i/Math.max(1,sampled.length-1);
          const width=maxWidth*(0.50+0.50*Math.pow(u,.72));
          left.push({x:sampled[i].x+nx*width/2,y:sampled[i].y+ny*width/2});
          right.push({x:sampled[i].x-nx*width/2,y:sampled[i].y-ny*width/2});
        }

        const hue=cursorState.lineHue;
        // Only the oldest ~7% fades. The rest is one continuous, solid ribbon.
        const fadeEnd=Math.max(2, Math.floor(sampled.length*.07));
        for(let i=0;i<fadeEnd;i++){
          const a=i/Math.max(1,fadeEnd-1);
          trailCtx.beginPath();
          trailCtx.moveTo(left[i].x,left[i].y);
          trailCtx.lineTo(left[i+1].x,left[i+1].y);
          trailCtx.lineTo(right[i+1].x,right[i+1].y);
          trailCtx.lineTo(right[i].x,right[i].y);
          trailCtx.closePath();
          trailCtx.fillStyle=`hsla(${hue},94%,60%,${(a*.88).toFixed(3)})`;
          trailCtx.fill();
        }
        if(fadeEnd < sampled.length-1){
          trailCtx.beginPath();
          trailCtx.moveTo(left[fadeEnd].x,left[fadeEnd].y);
          for(let i=fadeEnd+1;i<left.length;i++) trailCtx.lineTo(left[i].x,left[i].y);
          for(let i=right.length-1;i>=fadeEnd;i--) trailCtx.lineTo(right[i].x,right[i].y);
          trailCtx.closePath();
          trailCtx.fillStyle=`hsla(${hue},94%,60%,.90)`;
          trailCtx.fill();
        }
      }

      function updateBlindWindow(now){
        const blind = root.dataset.sitePalette === 'blind';
        if (!blind) {
          if (blindRing) blindRing.style.display='none';
          return;
        }
        const freqSeconds = 12 - (cursorState.motion / 100) * 10.7; // 12s → ~1.3s
        const amplitude = (cursorState.motion / 100) * .18;
        const phase = (now / 1000) * (Math.PI * 2 / Math.max(1.3,freqSeconds));
        const scale = 1 + Math.sin(phase) * amplitude;
        const diameter = clampValue(cursorState.size * scale, 20, 390);
        const radius = diameter / 2;
        root.style.setProperty('--blind-window-radius-live', `${radius}px`);
        root.style.setProperty('--blind-window-diameter-live', `${diameter}px`);
        if (blindRing) {
          blindRing.style.display='block';
          blindRing.style.width=`${diameter}px`;
          blindRing.style.height=`${diameter}px`;
          blindRing.style.transform=`translate3d(${pointerX-diameter/2}px,${pointerY-diameter/2}px,0)`;
        }
      }

      function animationFrame(now){
        drawRibbon(now);
        updateBlindWindow(now);
        updateMagnifier();
        requestAnimationFrame(animationFrame);
      }
      requestAnimationFrame(animationFrame);

      function applyCursorSettings(settings = {}) {
        Object.assign(cursorState, settings);
        body.dataset.cursorStyle = cursorState.style;
        root.style.setProperty('--cursor-size', `${cursorState.size}px`);
        root.style.setProperty('--cursor-spin-duration', `${22 - (cursorState.motion / 100) * 18}s`);
        root.style.setProperty('--cursor-spin-duration-fast', `${16 - (cursorState.motion / 100) * 13}s`);
        root.style.setProperty('--cursor-pulse-duration', `${12 - (cursorState.motion / 100) * 10.7}s`);
        root.style.setProperty('--cursor-pulse-scale', '1');
        root.style.setProperty('--cursor-zoom', String(cursorState.zoom));
        root.style.setProperty('--cursor-line-hue', String(cursorState.lineHue));
        root.style.setProperty('--cursor-invert-hue', String(cursorState.invertHue));
        trailCanvas?.classList.toggle('is-active', cursorState.style === 'line');
        if (cursorState.style !== 'line') pathPoints = [];
        document.dispatchEvent(new CustomEvent('scd:cursor-state-applied', { detail: { ...cursorState } }));
      }

      function applyBlindTone(value){
        const v = clampValue(Number(value), 0, 100);
        let overlay = 'rgba(0,0,0,1)', blur = '0px';
        if (v <= 50) {
          const t = v / 50;
          overlay = `rgba(0,0,0,${1 - t * 0.42})`;
          // Once the background starts to become visible, keep it strongly unreadable.
          blur = v === 0 ? '0px' : `${26 + t * 10}px`;
        } else {
          const t = (v - 50) / 50;
          overlay = `rgba(255,255,255,${0.22 + t * 0.73})`;
          // Bright blind states still retain strong blur rather than revealing text.
          blur = `${36 - t * 8}px`;
        }
        root.style.setProperty('--blind-overlay-color', overlay);
        root.style.setProperty('--blind-overlay-blur', blur);
      }
      applyBlindTone(0);

      function updatePointerPosition(x, y, collectTrail=true){
        pointerX=x; pointerY=y;
        if (dot) dot.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        if (invertLens) invertLens.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        root.style.setProperty('--mx', `${(x / innerWidth - .5) * 2}`);
        root.style.setProperty('--my', `${(y / innerHeight - .5) * 2}`);
        root.style.setProperty('--cursor-x', `${x}px`);
        root.style.setProperty('--cursor-y', `${y}px`);
        if (collectTrail && cursorState.style === 'line') {
          const now=performance.now();
          const prev=pathPoints[pathPoints.length-1];
          if (!prev) {
            pathPoints.push({x,y,t:now});
          } else {
            const dx=x-prev.x, dy=y-prev.y;
            const dist=Math.hypot(dx,dy);
            if(dist > 2.2){
              const steps=Math.max(1,Math.ceil(dist/7));
              const dt=Math.max(1,now-prev.t);
              for(let step=1;step<=steps;step++){
                const u=step/steps;
                pathPoints.push({x:prev.x+dx*u,y:prev.y+dy*u,t:prev.t+dt*u});
              }
            }
          }
          if(pathPoints.length>520) pathPoints.splice(0,pathPoints.length-520);
        }
      }

      addEventListener('pointermove', (e) => {
        updatePointerPosition(e.clientX, e.clientY, true);
        if (e.pointerType === 'touch') body.classList.add('touch-cursor-ready');
      }, { passive:true });
      addEventListener('pointerdown', (e) => {
        updatePointerPosition(e.clientX, e.clientY, false);
        if (e.pointerType === 'touch') body.classList.add('touch-cursor-ready');
      }, { passive:true });
      addEventListener('touchstart', (e) => {
        const t=e.touches?.[0];
        if(!t) return;
        body.classList.add('touch-cursor-ready');
        updatePointerPosition(t.clientX,t.clientY,false);
      }, { passive:true });
      addEventListener('touchmove', (e) => {
        const t=e.touches?.[0];
        if(!t) return;
        body.classList.add('touch-cursor-ready');
        updatePointerPosition(t.clientX,t.clientY,true);
      }, { passive:true });
      applyCursorSettings(cursorState);
      document.addEventListener('scd:update-cursor', (event) => applyCursorSettings(event.detail || {}));
      document.addEventListener('scd:update-blind-tone', (event) => applyBlindTone(event.detail?.value ?? 0));
      })();
    </script>

    <script is:inline>
      (() => {
      const V = {
        add:(a,b)=>({x:a.x+b.x,y:a.y+b.y}),
        sub:(a,b)=>({x:a.x-b.x,y:a.y-b.y}),
        mul:(a,s)=>({x:a.x*s,y:a.y*s}),
        dot:(a,b)=>a.x*b.x+a.y*b.y,
        cross:(a,b)=>a.x*b.y-a.y*b.x,
        len:(a)=>Math.hypot(a.x,a.y),
        norm:(a)=>{ const m=Math.hypot(a.x,a.y)||1; return {x:a.x/m,y:a.y/m}; },
        perp:(a)=>({x:-a.y,y:a.x})
      };
      function rotate2(p,c,a){
        const x=p.x-c.x, y=p.y-c.y, co=Math.cos(a), si=Math.sin(a);
        return {x:c.x+x*co-y*si, y:c.y+x*si+y*co};
      }
      function segmentNormal(a,b, towardPoint){
        let n = V.norm(V.perp(V.sub(b,a)));
        const mid = {x:(a.x+b.x)/2, y:(a.y+b.y)/2};
        if (V.dot(V.sub(towardPoint, mid), n) < 0) n = V.mul(n,-1);
        return n;
      }
      function refract(I, normal, n1, n2){
        let i = V.norm(I), n = V.norm(normal);
        let cosi = Math.max(-1, Math.min(1, V.dot(i,n)));
        let etai = n1, etat = n2;
        if (cosi > 0) {
          [etai, etat] = [etat, etai];
          n = V.mul(n,-1);
        } else {
          cosi = -cosi;
        }
        const eta = etai / etat;
        const k = 1 - eta*eta * (1 - cosi*cosi);
        if (k < 0) return null;
        return V.norm(V.add(V.mul(i, eta), V.mul(n, eta*cosi - Math.sqrt(k))));
      }
      function reflect(I, normal){
        const n = V.norm(normal), i = V.norm(I);
        return V.norm(V.sub(i, V.mul(n, 2*V.dot(i,n))));
      }
      function intersectRaySegment(p,d,a,b){
        const e = V.sub(b,a);
        const den = V.cross(d,e);
        if (Math.abs(den) < 1e-8) return null;
        const ap = V.sub(a,p);
