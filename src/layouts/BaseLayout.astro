            ctx.beginPath(); ctx.moveTo(pa.x-1.15,pa.y); ctx.lineTo(pb.x-1.15,pb.y); ctx.strokeStyle='rgba(236,44,73,.85)'; ctx.stroke();
            ctx.beginPath(); ctx.moveTo(pa.x+1.15,pa.y); ctx.lineTo(pb.x+1.15,pb.y); ctx.strokeStyle='rgba(55,208,228,.85)'; ctx.stroke();
          });
          ctx.strokeStyle='rgba(255,255,255,.22)';
          edges.forEach(([a,b])=>{ ctx.beginPath(); ctx.moveTo(pverts[a].x,pverts[a].y); ctx.lineTo(pverts[b].x,pverts[b].y); ctx.stroke(); });
        } else {
          ctx.strokeStyle='rgba(255,255,255,.84)';
          ctx.lineWidth=1.14;
          edges.forEach(([a,b])=>{
            ctx.beginPath(); ctx.moveTo(pverts[a].x,pverts[a].y); ctx.lineTo(pverts[b].x,pverts[b].y); ctx.stroke();
          });
        }
      }
      function animateScience(){
        const optics=document.querySelector('canvas[data-optics]');
        const solids=[...document.querySelectorAll('canvas[data-solid]')];
        if(!optics && !solids.length) return;
        function frame(t){
          if(optics) drawOptics(optics,t);
          solids.forEach(c=>drawWireSolid(c,c.dataset.solid,t));
          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      }
      animateScience();
      })();
    </script>
  </body>
</html>
