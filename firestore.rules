rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'osaki.akihiro@kagawa-u.ac.jp';
    }

    match /projects/{projectId} {
      // Public clients read only the counting start timestamp.
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /likes/{userId} {
        // Read access is currently required by the public aggregate-count query.
        allow read: if true;

        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;

        // Allows the same user to refresh an old pre-cutoff like into the new counting period.
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;

        allow delete: if (signedIn() && request.auth.uid == userId) || isAdmin();
      }

      match /events/{eventId} {
        // Like/unlike history is private to the administrator.
        allow read: if isAdmin();

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'action', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.action in ['like', 'unlike']
          && request.resource.data.createdAt == request.time;

        allow update, delete: if isAdmin();
      }
    }
  }
}
